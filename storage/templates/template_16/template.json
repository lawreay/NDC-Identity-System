{
  "id": "template_16",
  "name": "Clean Registry QR",
  "description": "Government registry style layout with left identity panel, strong personal details, and large QR validation area.",
  "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#f3f5f6;background-image:url('{{template.front_background}}');background-size:cover;background-position:center;font-family:Arial,sans-serif;color:#111;position:relative;padding:0;\">\n  <div style=\"position:absolute;left:0;top:0;width:31%;height:100%;background:rgba(232,236,237,.86);\"></div>\n  <div style=\"position:relative;width:100%;height:100%;display:grid;grid-template-columns:31% 36% 33%;align-items:center;padding:18px 20px;box-sizing:border-box;gap:18px;\">\n    <div style=\"height:100%;display:grid;grid-template-rows:auto 1fr auto;justify-items:center;align-items:center;gap:10px;\">\n      <div style=\"display:grid;justify-items:center;gap:4px;text-align:center;\"><img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:72px;height:72px;object-fit:contain;\"><div style=\"font-size:8px;font-weight:700;line-height:1.1;color:#29456f;max-width:118px;\">{{organization.name}}</div></div>\n      <div style=\"width:170px;height:190px;border:3px solid #111;background:#fff;overflow:hidden;display:flex;align-items:center;justify-content:center;\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n      <div style=\"text-align:center;width:100%;\"><div style=\"font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.2px;\">Student Identification Number</div><div style=\"font-size:25px;font-weight:800;letter-spacing:1px;margin-top:8px;\">{{student.student_id}}</div></div>\n    </div>\n    <div style=\"height:100%;display:grid;grid-template-rows:auto 1fr auto;align-items:center;\">\n      <div style=\"text-align:center;text-transform:uppercase;font-size:13px;line-height:1.22;font-weight:700;letter-spacing:.3px;\">{{organization.school_name}}<br><span style=\"font-size:12px;\">{{organization.campus_name}}</span><br><span style=\"font-size:15px;\">Student Registry</span></div>\n      <div style=\"display:grid;gap:7px;align-content:center;\">\n        <div><div style=\"font-size:10px;font-weight:700;text-transform:uppercase;\">Last / Full Name:</div><div style=\"font-size:22px;font-weight:900;line-height:1;\">{{student.full_name}}</div></div>\n        <div><div style=\"font-size:10px;font-weight:700;text-transform:uppercase;\">Program:</div><div style=\"font-size:18px;font-weight:800;line-height:1.05;\">{{student.program}}</div></div>\n        <div><div style=\"font-size:10px;font-weight:700;text-transform:uppercase;\">Department:</div><div style=\"font-size:18px;font-weight:800;line-height:1.05;\">{{student.department}}</div></div>\n        <div><div style=\"font-size:10px;font-weight:700;text-transform:uppercase;\">Date of Birth:</div><div style=\"font-size:20px;font-weight:900;line-height:1.05;\">{{student.date_of_birth}}</div></div>\n      </div>\n      <div><div style=\"font-size:10px;font-weight:700;text-transform:uppercase;\">Valid Until:</div><div style=\"font-size:20px;font-weight:900;\">{{student.expiry_date}}</div></div>\n    </div>\n    <div style=\"height:100%;display:grid;grid-template-rows:1fr auto;align-items:center;justify-items:center;gap:10px;\">\n      <div style=\"width:214px;height:214px;border:3px solid #111;background:#fff;display:flex;align-items:center;justify-content:center;box-sizing:border-box;\">{{card.qr_code}}</div>\n      <div style=\"text-align:center;\"><div style=\"font-size:9px;font-weight:700;text-transform:uppercase;\">Digital ID Control Number</div><div style=\"font-size:16px;font-weight:800;letter-spacing:.4px;\">{{card.verification_code}}</div></div>\n    </div>\n  </div>\n</div>",
  "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#f3f5f6;background-image:url('{{template.back_background}}');background-size:cover;background-position:center;font-family:Arial,sans-serif;color:#111;position:relative;\">\n  <div style=\"position:absolute;left:0;top:0;width:31%;height:100%;background:rgba(232,236,237,.86);\"></div>\n  <div style=\"position:relative;width:100%;height:100%;display:grid;grid-template-columns:58% 42%;align-items:center;padding:34px 24px;box-sizing:border-box;gap:20px;\">\n    <div style=\"display:grid;gap:24px;\"><div><div style=\"font-size:17px;text-transform:uppercase;\">Student Identification Number</div><div style=\"font-size:28px;font-weight:900;letter-spacing:.8px;margin-top:8px;\">{{student.student_id}}-00000</div></div><div><div style=\"font-size:17px;text-transform:uppercase;\">Digital ID Control Number</div><div style=\"font-size:28px;font-weight:900;letter-spacing:.8px;margin-top:8px;\">{{card.verification_code}}</div></div></div>\n    <div style=\"display:grid;justify-items:center;gap:12px;\"><div style=\"width:230px;height:230px;border:3px solid #111;background:#fff;display:flex;align-items:center;justify-content:center;box-sizing:border-box;\">{{card.qr_code}}</div><div style=\"font-size:16px;text-transform:uppercase;font-weight:700;\">Scan to Validate Info</div></div>\n  </div>\n</div>",
