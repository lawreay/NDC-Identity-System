{
    "id": "template_17",
    "name": "Airport Staff Badge",
    "description": "Staff credential layout with bold navy header, boxed photo, label/value profile rows, barcode, and signature back.",
    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#f8fafc;background-image:url('{{template.front_background}}');background-size:cover;background-position:center;font-family:Arial,sans-serif;color:#111;position:relative;padding:28px 32px 24px;\">\r\n  <div style=\"position:absolute;left:0;right:0;top:0;height:92px;background:#071f58;\"></div>\r\n  <div style=\"position:absolute;left:0;right:0;bottom:0;height:18px;background:#071f58;\"></div>\r\n  <div style=\"position:relative;height:100%;display:grid;grid-template-rows:74px 1fr;gap:18px;\">\r\n    <div style=\"display:grid;grid-template-columns:1fr 86px;align-items:center;color:#fff;\"><div style=\"font-size:30px;line-height:1.08;font-weight:900;text-align:center;letter-spacing:1px;text-transform:uppercase;\">{{organization.name}}<br><span style=\"font-size:24px;\">Student ID</span></div><img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:76px;height:58px;object-fit:contain;background:#fff;padding:6px;box-sizing:border-box;\"></div>\r\n    <div style=\"display:grid;grid-template-columns:210px 1fr;gap:28px;align-items:center;\">\r\n      <div style=\"display:grid;justify-items:center;gap:8px;\"><div style=\"width:190px;height:210px;border:4px solid #071f58;background:#fff;overflow:hidden;\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div><div style=\"font-size:12px;font-weight:800;color:#071f58;\">{{student.student_id}}</div></div>\r\n      <div style=\"display:grid;gap:13px;font-size:20px;line-height:1.1;\">\r\n        <div style=\"display:grid;grid-template-columns:138px 1fr;gap:12px;\"><span>Name:</span><strong>{{student.full_name}}</strong></div>\r\n        <div style=\"display:grid;grid-template-columns:138px 1fr;gap:12px;\"><span>Campus:</span><strong>{{organization.campus_name}}</strong></div>\r\n        <div style=\"display:grid;grid-template-columns:138px 1fr;gap:12px;\"><span>Program:</span><strong>{{student.program}}</strong></div>\r\n        <div style=\"display:grid;grid-template-columns:138px 1fr;gap:12px;\"><span>DOB:</span><strong>{{student.date_of_birth}}</strong></div>\r\n        <div style=\"display:grid;grid-template-columns:138px 1fr;gap:12px;\"><span>Status:</span><strong>{{student.status}}</strong></div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#f8fafc;background-image:url('{{template.back_background}}');background-size:cover;background-position:center;font-family:Arial,sans-serif;color:#111;position:relative;padding:34px 34px 28px;\">\r\n  <div style=\"position:absolute;left:0;right:0;top:0;height:34px;background:#071f58;\"></div>\r\n  <div style=\"position:absolute;left:0;right:0;bottom:0;height:46px;background:#071f58;\"></div>\r\n  <div style=\"position:relative;height:100%;display:grid;grid-template-rows:1fr auto;gap:18px;\">\r\n    <div style=\"font-size:14px;line-height:1.35;\"><strong style=\"text-transform:uppercase;\">Conditions of Use:</strong><br>1. This card remains property of <strong>{{organization.name}}</strong>.<br>2. If found, please return it to {{organization.address}}.<br>3. This card must be presented on request and is non-transferable.<br><br><strong style=\"text-transform:uppercase;\">Security Instructions:</strong> Verify this card using the barcode or QR record before granting access.</div>\r\n    <div style=\"display:grid;grid-template-columns:1fr 220px;align-items:end;gap:34px;\"><div style=\"display:grid;gap:4px;text-align:center;justify-items:start;\"><div style=\"width:255px;height:54px;display:flex;align-items:center;justify-content:center;\"><span style=\"width:150px;height:42px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.barcode}}</span></div><div style=\"font-size:13px;font-weight:700;width:255px;\">BARCODE 1</div></div><div style=\"display:grid;justify-items:center;gap:3px;\"><div>{{authorized.signature}}</div><div style=\"width:210px;border-top:2px solid #111;text-align:center;font-size:13px;padding-top:2px;\">Signature</div></div></div>\r\n  </div>\r\n</div>",
    "front_background_path": "storage/templates/template_17/front-background.png",
    "back_background_path": "storage/templates/template_17/back-background.png",
