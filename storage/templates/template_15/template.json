{
    "id": "template_15",
    "name": "Vertical Access Copy",
    "description": "Portrait-card style panel inside a landscape ID.",
    "front_html": "<div \r\n     style=\"width:100%;\r\n            height:100%;\r\n            box-sizing:border-box;\r\n            overflow:hidden;\r\n            background:#edf2ed;\r\n            font-family:Arial,sans-serif;\r\n            color:#172033;\r\n            padding:18px;\">\r\n  <div style=\"width:100%;\r\n              height:100%;\r\n              display:grid;\r\n              grid-template-columns:160px 1fr;\r\n              gap:20px;\">\r\n    <div style=\"height:100%;background:#ffffff;border-radius:8px;box-shadow:0 10px 22px rgba(21,32,28,.12);padding:12px;box-sizing:border-box;display:grid;grid-template-rows:auto 1fr auto;gap:10px;justify-items:center;\"><img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:44px;height:44px;object-fit:contain;\"><div style=\"width:112px;height:150px;border-radius:8px;overflow:hidden;border:4px solid #5ca044;\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div><div style=\"font-size:9px;text-align:center;color:#5b6659;\"><span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span><br>{{student.student_id}}</div></div><div style=\"height:100%;display:grid;grid-template-rows:auto 1fr auto;gap:12px;padding:8px 0;box-sizing:border-box;\"><div><div style=\"font-size:10px;color:#5ca044;text-transform:uppercase;letter-spacing:1px;\">Campus Access</div><div style=\"font-size:29px;font-weight:700;line-height:1;\">{{student.full_name}}</div><div style=\"font-size:12px;color:#5b6659;margin-top:5px;\">{{student.program}}</div></div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;align-content:center;font-size:11px;\"><div><strong>Department</strong><br>{{student.department}}</div><div><strong>Class</strong><br>{{student.class_level}}</div><div><strong>Status</strong><br>{{student.status}}</div><div><strong>Expires</strong><br>{{student.expiry_date}}</div></div><div style=\"height:36px;background:#5ca044;border-radius:8px;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 14px;font-size:10px;box-sizing:border-box;\"><span>{{organization.name}}</span><span>{{organization.website}}</span></div></div></div></div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#edf2ed;font-family:Arial,sans-serif;color:#172033;padding:18px;\"><div style=\"width:100%;height:100%;background:#fff;border-radius:8px;padding:18px;box-sizing:border-box;display:grid;grid-template-columns:1fr 160px;gap:20px;align-items:center;\"><div style=\"font-size:11px;line-height:1.55;display:grid;gap:10px;\"><strong style=\"font-size:18px;color:#3f7d31;\">Terms of Use</strong><span>If found, return this card to {{organization.name}}.</span><span>{{organization.address}}<br>{{organization.phone}}<br>{{organization.email}}</span><span>Authorized by <strong>{{authorized.name}}</strong></span></div><div style=\"display:grid;justify-items:center;gap:10px;font-size:9px;color:#5b6659;text-align:center;\"><span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span>Verification</div></div></div>",
    "front_background_path": "storage/templates/template_5/front-background.png",
    "back_background_path": "storage/templates/template_5/back-background.png",
    "thumbnail_path": "storage/templates/template_5/thumbnail.png",
    "status": "active",
