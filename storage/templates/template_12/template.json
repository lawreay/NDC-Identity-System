    "description": "Elegant marble texture and serif accents.",
    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#071d33;font-family:Arial,sans-serif;color:#eef8ff;position:relative;padding:18px;\">\r\n  <div style=\"position:absolute;left:-80px;top:-100px;width:280px;height:280px;border:24px solid #10a8f5;border-radius:50%;opacity:.45;\"></div>\r\n  <div style=\"position:absolute;right:-130px;bottom:-150px;width:330px;height:330px;border:28px solid #0ea5e9;border-radius:50%;opacity:.32;\"></div>\r\n  <div style=\"position:relative;width:100%;height:100%;display:grid;grid-template-columns:210px 1fr;gap:22px;align-items:center;\">\r\n    <div style=\"display:grid;justify-items:center;gap:14px;\"><div style=\"width:154px;height:154px;border-radius:50%;border:8px solid #19b9ff;padding:6px;background:#08233e;box-sizing:border-box;\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;\"></div><div style=\"font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#8bdcff;\">{{student.student_id}}</div></div>\r\n    <div style=\"display:grid;gap:16px;\"><div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:20px;\"><div><div style=\"font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#8bdcff;\">Student Identity</div><div style=\"font-size:30px;line-height:1;font-weight:700;margin-top:6px;\">{{student.full_name}}</div><div style=\"font-size:13px;color:#bfd7ea;margin-top:6px;\">{{student.program}}</div></div><img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:66px;height:66px;object-fit:contain;background:#ffffff;border-radius:8px;padding:7px;box-sizing:border-box;\"></div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:11px;color:#e5f4ff;\"><div style=\"border-left:3px solid #19b9ff;padding:7px 10px;background:rgba(255,255,255,.06);\"><span style=\"color:#8bdcff;\">Dept</span><br><strong>{{student.department}}</strong></div><div style=\"border-left:3px solid #19b9ff;padding:7px 10px;background:rgba(255,255,255,.06);\"><span style=\"color:#8bdcff;\">Valid</span><br><strong>{{student.expiry_date}}</strong></div></div><div style=\"display:flex;justify-content:space-between;align-items:center;border-top:1px solid rgba(255,255,255,.18);padding-top:12px;font-size:10px;color:#bfd7ea;\"><span>{{organization.website}}</span><span><span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span></span></div></div>\r\n  </div>\r\n</div>",
    "back_html": "<div id=\"ndc-card-front\"\r\n     style=\"\r\n        width:100%;\r\n        height:100%;\r\n        box-sizing:border-box;\r\n        overflow:hidden;\r\n        background:#071d33;\r\n        font-family:Arial,sans-serif;\r\n        color:#eef8ff;\r\n        position:relative;\r\n        padding:18px;\r\n     \">\r\n\r\n  <!-- Decorative circles -->\r\n  <div style=\"\r\n      position:absolute;\r\n      left:-80px;\r\n      top:-100px;\r\n      width:280px;\r\n      height:280px;\r\n      border:24px solid #10a8f5;\r\n      border-radius:50%;\r\n      opacity:.45;\r\n      box-sizing:border-box;\r\n  \"></div>\r\n\r\n  <div style=\"\r\n      position:absolute;\r\n      right:-130px;\r\n      bottom:-150px;\r\n      width:330px;\r\n      height:330px;\r\n      border:28px solid #0ea5e9;\r\n      border-radius:50%;\r\n      opacity:.32;\r\n      box-sizing:border-box;\r\n  \"></div>\r\n\r\n\r\n  <!-- Main layout -->\r\n  <div style=\"\r\n      position:relative;\r\n      width:100%;\r\n      height:100%;\r\n      min-width:0;\r\n      min-height:0;\r\n      display:grid;\r\n      grid-template-columns:210px minmax(0,1fr);\r\n      gap:22px;\r\n      align-items:center;\r\n      box-sizing:border-box;\r\n  \">\r\n\r\n\r\n    <!-- Student photo -->\r\n    <div style=\"\r\n        width:210px;\r\n        display:grid;\r\n        justify-items:center;\r\n        align-content:center;\r\n        gap:12px;\r\n        box-sizing:border-box;\r\n    \">\r\n\r\n      <div style=\"\r\n          width:154px;\r\n          height:154px;\r\n          border-radius:50%;\r\n          border:8px solid #19b9ff;\r\n          padding:6px;\r\n          background:#08233e;\r\n          box-sizing:border-box;\r\n          overflow:hidden;\r\n      \">\r\n        <img\r\n          src=\"{{student.photo}}\"\r\n          alt=\"Student photo\"\r\n          style=\"\r\n              width:100%;\r\n              height:100%;\r\n              max-width:100%;\r\n              max-height:100%;\r\n              object-fit:cover;\r\n              border-radius:50%;\r\n              display:block;\r\n          \"\r\n        >\r\n      </div>\r\n\r\n      <div style=\"\r\n          max-width:190px;\r\n          overflow:hidden;\r\n          white-space:nowrap;\r\n          text-overflow:ellipsis;\r\n          font-size:10px;\r\n          line-height:1.2;\r\n          text-transform:uppercase;\r\n          letter-spacing:1px;\r\n          color:#8bdcff;\r\n          text-align:center;\r\n      \">\r\n        {{student.student_id}}\r\n      </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- Student information -->\r\n    <div style=\"\r\n        min-width:0;\r\n        width:100%;\r\n        display:grid;\r\n        gap:14px;\r\n        box-sizing:border-box;\r\n    \">\r\n\r\n\r\n      <!-- Header -->\r\n      <div style=\"\r\n          min-width:0;\r\n          display:flex;\r\n          justify-content:space-between;\r\n          align-items:flex-start;\r\n          gap:16px;\r\n          box-sizing:border-box;\r\n      \">\r\n\r\n        <!-- Student name/details -->\r\n        <div style=\"\r\n            min-width:0;\r\n            flex:1 1 auto;\r\n            overflow:hidden;\r\n        \">\r\n\r\n          <div style=\"\r\n              font-size:11px;\r\n              line-height:1.2;\r\n              text-transform:uppercase;\r\n              letter-spacing:1px;\r\n              color:#8bdcff;\r\n          \">\r\n            Student Identity\r\n          </div>\r\n\r\n          <div style=\"\r\n              min-width:0;\r\n              max-width:100%;\r\n              overflow:hidden;\r\n              text-overflow:ellipsis;\r\n              white-space:nowrap;\r\n              font-size:30px;\r\n              line-height:1.1;\r\n              font-weight:700;\r\n              margin-top:6px;\r\n              color:#ffffff;\r\n          \">\r\n            {{student.full_name}}\r\n          </div>\r\n\r\n          <div style=\"\r\n              min-width:0;\r\n              max-width:100%;\r\n              overflow:hidden;\r\n              text-overflow:ellipsis;\r\n              white-space:nowrap;\r\n              font-size:13px;\r\n              line-height:1.2;\r\n              color:#bfd7ea;\r\n              margin-top:7px;\r\n          \">\r\n            {{student.program}}\r\n          </div>\r\n\r\n        </div>\r\n\r\n\r\n        <!-- Organization logo -->\r\n        <div style=\"\r\n            width:66px;\r\n            height:66px;\r\n            flex:0 0 66px;\r\n            display:flex;\r\n            align-items:center;\r\n            justify-content:center;\r\n            background:#ffffff;\r\n            border-radius:8px;\r\n            padding:7px;\r\n            box-sizing:border-box;\r\n            overflow:hidden;\r\n        \">\r\n          <img\r\n            src=\"{{organization.logo}}\"\r\n            alt=\"Organization logo\"\r\n            style=\"\r\n                width:100%;\r\n                height:100%;\r\n                max-width:100%;\r\n                max-height:100%;\r\n                object-fit:contain;\r\n                display:block;\r\n            \"\r\n          >\r\n        </div>\r\n\r\n      </div>\r\n\r\n\r\n      <!-- Student metadata -->\r\n      <div style=\"\r\n          display:grid;\r\n          grid-template-columns:minmax(0,1fr) minmax(0,1fr);\r\n          gap:10px;\r\n          font-size:11px;\r\n          line-height:1.25;\r\n          color:#e5f4ff;\r\n          box-sizing:border-box;\r\n      \">\r\n\r\n        <div style=\"\r\n            min-width:0;\r\n            border-left:3px solid #19b9ff;\r\n            padding:7px 10px;\r\n            background:rgba(255,255,255,.06);\r\n            box-sizing:border-box;\r\n            overflow:hidden;\r\n        \">\r\n          <span style=\"\r\n              color:#8bdcff;\r\n              font-size:10px;\r\n              text-transform:uppercase;\r\n          \">\r\n            Department\r\n          </span>\r\n          <br>\r\n          <strong style=\"\r\n              display:block;\r\n              margin-top:2px;\r\n              overflow:hidden;\r\n              text-overflow:ellipsis;\r\n              white-space:nowrap;\r\n          \">\r\n            {{student.department}}\r\n          </strong>\r\n        </div>\r\n\r\n\r\n        <div style=\"\r\n            min-width:0;\r\n            border-left:3px solid #19b9ff;\r\n            padding:7px 10px;\r\n            background:rgba(255,255,255,.06);\r\n            box-sizing:border-box;\r\n            overflow:hidden;\r\n        \">\r\n          <span style=\"\r\n              color:#8bdcff;\r\n              font-size:10px;\r\n              text-transform:uppercase;\r\n          \">\r\n            Valid Until\r\n          </span>\r\n          <br>\r\n          <strong style=\"\r\n              display:block;\r\n              margin-top:2px;\r\n              overflow:hidden;\r\n              text-overflow:ellipsis;\r\n              white-space:nowrap;\r\n          \">\r\n            {{student.expiry_date}}\r\n          </strong>\r\n        </div>\r\n\r\n      </div>\r\n\r\n\r\n      <!-- Footer -->\r\n      <div style=\"\r\n          min-width:0;\r\n          display:flex;\r\n          justify-content:space-between;\r\n          align-items:center;\r\n          gap:14px;\r\n          border-top:1px solid rgba(255,255,255,.18);\r\n          padding-top:10px;\r\n          font-size:10px;\r\n          line-height:1.2;\r\n          color:#bfd7ea;\r\n          box-sizing:border-box;\r\n      \">\r\n\r\n        <span style=\"\r\n            min-width:0;\r\n            max-width:calc(100% - 70px);\r\n            overflow:hidden;\r\n            text-overflow:ellipsis;\r\n            white-space:nowrap;\r\n        \">\r\n          {{organization.website}}\r\n        </span>\r\n\r\n\r\n        <!-- QR code -->\r\n        <span style=\"\r\n            width:54px;\r\n            height:54px;\r\n            flex:0 0 54px;\r\n            display:flex;\r\n            align-items:center;\r\n            justify-content:center;\r\n            line-height:0;\r\n            overflow:hidden;\r\n            vertical-align:middle;\r\n            box-sizing:border-box;\r\n        \">\r\n          {{card.qr_code}}\r\n        </span>\r\n\r\n      </div>\r\n\r\n    </div>\r\n\r\n  </div>\r\n\r\n</div>",
