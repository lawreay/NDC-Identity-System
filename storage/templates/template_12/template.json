    "name": "Classic Marble",
    "description": "Elegant marble texture and serif accents.",
    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#071d33;font-family:Arial,sans-serif;color:#eef8ff;position:relative;padding:22px;\">\r\n\r\n  <div style=\"position:absolute;left:-100px;top:-120px;width:330px;height:330px;border:28px solid #10a8f5;border-radius:50%;opacity:.45;box-sizing:border-box;\"></div>\r\n  <div style=\"position:absolute;right:-150px;bottom:-170px;width:390px;height:390px;border:32px solid #0ea5e9;border-radius:50%;opacity:.32;box-sizing:border-box;\"></div>\r\n\r\n  <div style=\"position:relative;width:100%;height:100%;min-width:0;min-height:0;display:grid;grid-template-columns:250px minmax(0,1fr);gap:28px;align-items:center;box-sizing:border-box;\">\r\n\r\n    <!-- PHOTO -->\r\n    <div style=\"width:250px;display:grid;justify-items:center;align-content:center;gap:16px;box-sizing:border-box;\">\r\n\r\n      <div style=\"width:200px;height:200px;border-radius:50%;border:10px solid #19b9ff;padding:8px;background:#08233e;box-sizing:border-box;overflow:hidden;\">\r\n        <img src=\"{{student.photo}}\" alt=\"Student photo\"\r\n             style=\"width:100%;height:100%;max-width:100%;max-height:100%;object-fit:cover;border-radius:50%;display:block;\">\r\n      </div>\r\n\r\n      <div style=\"max-width:220px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:13px;line-height:1.2;font-weight:700;text-transform:uppercase;letter-spacing:1.4px;color:#8bdcff;text-align:center;\">\r\n        {{student.student_id}}\r\n      </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- INFORMATION -->\r\n    <div style=\"min-width:0;width:100%;display:grid;gap:18px;box-sizing:border-box;\">\r\n\r\n      <!-- NAME -->\r\n      <div style=\"min-width:0;display:flex;justify-content:space-between;align-items:flex-start;gap:18px;box-sizing:border-box;\">\r\n\r\n        <div style=\"min-width:0;flex:1 1 auto;overflow:hidden;\">\r\n\r\n          <div style=\"font-size:13px;line-height:1.2;text-transform:uppercase;letter-spacing:1.4px;font-weight:700;color:#8bdcff;\">\r\n            Student Identity\r\n          </div>\r\n\r\n          <div style=\"min-width:0;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:38px;line-height:1.05;font-weight:700;margin-top:8px;color:#ffffff;\">\r\n            {{student.full_name}}\r\n          </div>\r\n\r\n          <div style=\"min-width:0;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:17px;line-height:1.2;font-weight:500;color:#bfd7ea;margin-top:9px;\">\r\n            {{student.program}}\r\n          </div>\r\n\r\n        </div>\r\n\r\n        <!-- LOGO -->\r\n        <div style=\"width:86px;height:86px;flex:0 0 86px;display:flex;align-items:center;justify-content:center;background:#ffffff;border-radius:10px;padding:9px;box-sizing:border-box;overflow:hidden;\">\r\n          <img src=\"{{organization.logo}}\" alt=\"Organization logo\"\r\n               style=\"width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain;display:block;\">\r\n        </div>\r\n\r\n      </div>\r\n\r\n\r\n      <!-- DETAILS -->\r\n      <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;font-size:13px;line-height:1.25;color:#e5f4ff;box-sizing:border-box;\">\r\n\r\n        <div style=\"min-width:0;border-left:5px solid #19b9ff;padding:11px 14px;background:rgba(255,255,255,.07);box-sizing:border-box;overflow:hidden;\">\r\n          <span style=\"color:#8bdcff;font-size:11px;font-weight:700;text-transform:uppercase;\">\r\n            Department\r\n          </span>\r\n          <br>\r\n          <strong style=\"display:block;margin-top:4px;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">\r\n            {{student.department}}\r\n          </strong>\r\n        </div>\r\n\r\n        <div style=\"min-width:0;border-left:5px solid #19b9ff;padding:11px 14px;background:rgba(255,255,255,.07);box-sizing:border-box;overflow:hidden;\">\r\n          <span style=\"color:#8bdcff;font-size:11px;font-weight:700;text-transform:uppercase;\">\r\n            Valid Until\r\n          </span>\r\n          <br>\r\n          <strong style=\"display:block;margin-top:4px;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">\r\n            {{student.expiry_date}}\r\n          </strong>\r\n        </div>\r\n\r\n      </div>\r\n\r\n\r\n      <!-- FOOTER -->\r\n      <div style=\"min-width:0;display:flex;justify-content:space-between;align-items:center;gap:16px;border-top:1px solid rgba(255,255,255,.22);padding-top:12px;font-size:12px;line-height:1.2;color:#bfd7ea;box-sizing:border-box;\">\r\n\r\n        <span style=\"min-width:0;max-width:calc(100% - 82px);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">\r\n          {{organization.website}}\r\n        </span>\r\n\r\n        <span style=\"width:70px;height:70px;flex:0 0 70px;display:flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;box-sizing:border-box;\">\r\n          {{card.qr_code}}\r\n        </span>\r\n\r\n      </div>\r\n\r\n    </div>\r\n\r\n  </div>\r\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#071d33;font-family:Arial,sans-serif;color:#eef8ff;position:relative;padding:24px;\">\r\n\r\n  <div style=\"position:absolute;left:-120px;top:-140px;width:350px;height:350px;border:28px solid #10a8f5;border-radius:50%;opacity:.24;box-sizing:border-box;\"></div>\r\n\r\n  <div style=\"position:absolute;right:-140px;bottom:-170px;width:370px;height:370px;border:30px solid #0ea5e9;border-radius:50%;opacity:.22;box-sizing:border-box;\"></div>\r\n\r\n\r\n  <div style=\"position:relative;width:100%;height:100%;min-width:0;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) 200px;gap:28px;align-items:center;box-sizing:border-box;\">\r\n\r\n    <!-- ORGANIZATION INFORMATION -->\r\n    <div style=\"min-width:0;display:grid;gap:15px;font-size:14px;line-height:1.5;color:#bfd7ea;box-sizing:border-box;\">\r\n\r\n      <strong style=\"display:block;font-size:24px;line-height:1.15;color:#ffffff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">\r\n        {{organization.name}}\r\n      </strong>\r\n\r\n      <span style=\"display:block;overflow:hidden;\">\r\n        {{organization.address}}\r\n        <br>\r\n        {{organization.phone}}\r\n        <br>\r\n        {{organization.email}}\r\n      </span>\r\n\r\n      <span style=\"display:block;max-width:100%;\">\r\n        This card is non-transferable and must be returned if found.\r\n      </span>\r\n\r\n      <span style=\"display:block;\">\r\n        Authorized by\r\n        <strong style=\"color:#ffffff;\">\r\n          {{authorized.name}}\r\n        </strong>\r\n      </span>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- VERIFICATION -->\r\n    <div style=\"width:200px;display:grid;justify-items:center;align-content:center;gap:12px;text-align:center;color:#8bdcff;font-size:12px;line-height:1.2;box-sizing:border-box;\">\r\n\r\n      <!-- QR -->\r\n      <span style=\"width:72px;height:72px;flex:0 0 72px;display:flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;box-sizing:border-box;\">\r\n        {{card.qr_code}}\r\n      </span>\r\n\r\n      <span style=\"display:block;font-size:12px;font-weight:700;line-height:1.2;text-transform:uppercase;letter-spacing:.7px;\">\r\n        Scan to verify\r\n      </span>\r\n\r\n      <!-- BARCODE -->\r\n      <span style=\"width:180px;height:54px;display:flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;box-sizing:border-box;\">\r\n        {{card.barcode}}\r\n      </span>\r\n\r\n    </div>\r\n\r\n  </div>\r\n</div>",
