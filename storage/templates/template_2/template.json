{
    "id": "template_2",
    "name": "Amber Hex Profile",
    "description": "White and gold hexagon photo layout.",
    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#fffaf0;font-family:Arial,sans-serif;color:#2d2a26;position:relative;padding:16px;\">\n  <div style=\"position:absolute;left:-55px;top:32px;width:250px;height:250px;background:#f6b51e;clip-path:polygon(25% 4%,75% 4%,100% 50%,75% 96%,25% 96%,0 50%);\"></div>\n  <div style=\"position:relative;width:100%;height:100%;display:grid;grid-template-columns:245px 1fr;gap:18px;align-items:center;\"><div style=\"display:grid;justify-items:center;gap:14px;\"><div style=\"width:142px;height:164px;clip-path:polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0 50%);background:#fff;padding:6px;box-sizing:border-box;\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;clip-path:polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0 50%);\"></div><div style=\"font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;\">{{organization.name}}</div></div><div style=\"background:#fff;border:1px solid #f1d799;border-radius:8px;padding:20px;display:grid;grid-template-rows:auto 1fr auto;gap:14px;height:82%;box-sizing:border-box;box-shadow:0 12px 24px rgba(47,38,20,.08);\"><div><div style=\"font-size:11px;color:#b77900;text-transform:uppercase;letter-spacing:1px;\">Academic Pass</div><div style=\"font-size:27px;font-weight:700;line-height:1.05;\">{{student.full_name}}</div><div style=\"font-size:12px;color:#6b6256;margin-top:4px;\">{{student.qualification}}</div></div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:11px;align-content:center;\"><div><strong>ID</strong><br>{{student.student_id}}</div><div><strong>Status</strong><br>{{student.status}}</div><div><strong>Program</strong><br>{{student.program}}</div><div><strong>Expires</strong><br>{{student.expiry_date}}</div></div><div style=\"display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#6b6256;border-top:1px solid #f1d799;padding-top:10px;\"><span>{{organization.phone}}</span><span><span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span></span></div></div></div>\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#fffaf0;font-family:Arial,sans-serif;color:#2d2a26;padding:18px;\">\n  <div style=\"width:100%;height:100%;display:grid;grid-template-columns:1fr 170px;gap:18px;align-items:center;background:#fff;border:1px solid #f1d799;border-radius:8px;padding:18px;box-sizing:border-box;\"><div style=\"font-size:11px;line-height:1.55;display:grid;gap:10px;\"><strong style=\"font-size:17px;color:#9a6500;\">Return Information</strong><span>This card identifies {{student.full_name}} as a registered student of {{organization.name}}.</span><span><strong>Address</strong><br>{{organization.address}}</span><span><strong>Contact</strong><br>{{organization.phone}} / {{organization.email}}</span></div><div style=\"display:grid;justify-items:center;gap:10px;text-align:center;font-size:9px;color:#8c5a00;\"><span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span>Verification<span style=\"width:150px;height:42px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.barcode}}</span><span>{{authorized.name}}</span></div></div>\n</div>",
    "front_background_path": "storage/templates/template_2/front-background.png",
    "back_background_path": "storage/templates/template_2/back-background.png",
    "thumbnail_path": "storage/templates/template_2/thumbnail.png",
    "status": "active",
    "created_by": "Administrator",
