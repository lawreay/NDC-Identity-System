{
    "id": "template_18",
    "name": "Modern Teal Student Card",
    "description": "Large title student ID design with circular photo, teal geometric shapes, right information stack, and university ribbon.",
    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#f4f5f6;background-image:url('{{template.front_background}}');background-size:cover;background-position:center;font-family:Arial,sans-serif;color:#111;position:relative;padding:38px 42px;\">\n  <div style=\"position:absolute;left:0;bottom:0;width:330px;height:132px;background:#86ead4;\"></div>\n  <div style=\"position:absolute;left:198px;bottom:-36px;width:190px;height:190px;background:#128db2;transform:skew(-28deg);\"></div>\n  <div style=\"position:absolute;right:62px;top:0;width:156px;height:154px;background:#118eb4;clip-path:polygon(0 0,100% 0,100% 100%,50% 76%,0 100%);\"></div>\n  <div style=\"position:absolute;right:92px;top:26px;width:96px;text-align:center;color:#fff;\"><img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:54px;height:54px;object-fit:contain;filter:brightness(0) invert(1);\"><div style=\"font-size:12px;line-height:1.2;margin-top:10px;text-transform:uppercase;\">{{organization.name}}</div></div>\n  <div style=\"position:absolute;right:70px;top:246px;width:84px;height:66px;border:4px solid #118eb4;border-radius:50%;opacity:.9;\"></div>\n  <div style=\"position:absolute;right:40px;top:246px;width:84px;height:66px;border:4px solid #86ead4;border-radius:50%;opacity:.95;\"></div>\n  <div style=\"position:relative;height:100%;display:grid;grid-template-rows:auto 1fr;gap:22px;\">\n    <div style=\"font-size:54px;line-height:.95;font-weight:900;letter-spacing:2px;color:#118eb4;text-transform:uppercase;\">Student ID Card</div>\n    <div style=\"display:grid;grid-template-columns:390px 1fr;gap:44px;align-items:center;\">\n      <div style=\"display:grid;align-items:end;height:100%;\"><div style=\"width:284px;height:284px;border:7px solid #118eb4;border-radius:50%;overflow:hidden;background:#fff;margin-left:30px;margin-bottom:18px;\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div><div style=\"font-size:13px;line-height:1.55;text-transform:uppercase;\">Valid Until:<br>{{student.expiry_date}}</div></div>\n      <div style=\"display:grid;gap:21px;align-content:center;padding-right:166px;\">\n        <div><div style=\"font-size:22px;font-weight:900;color:#118eb4;text-transform:uppercase;\">Name:</div><div style=\"font-size:17px;margin-top:7px;padding-bottom:8px;border-bottom:1px solid #111;\">{{student.full_name}}</div></div>\n        <div><div style=\"font-size:22px;font-weight:900;color:#118eb4;text-transform:uppercase;\">Student ID:</div><div style=\"font-size:17px;margin-top:7px;padding-bottom:8px;border-bottom:1px solid #111;\">{{student.student_id}}</div></div>\n        <div><div style=\"font-size:22px;font-weight:900;color:#118eb4;text-transform:uppercase;\">Program:</div><div style=\"font-size:15px;margin-top:7px;padding-bottom:8px;border-bottom:1px solid #111;text-transform:uppercase;\">{{student.program}}</div></div>\n        <div><div style=\"font-size:22px;font-weight:900;color:#118eb4;text-transform:uppercase;\">Date of Birth:</div><div style=\"font-size:17px;margin-top:7px;padding-bottom:8px;border-bottom:1px solid #111;\">{{student.date_of_birth}}</div></div>\n        <div style=\"width:228px;height:42px;display:flex;align-items:center;justify-content:flex-start;\"><span style=\"width:150px;height:42px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.barcode}}</span></div>\n      </div>\n    </div>\n  </div>\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#f4f5f6;background-image:url('{{template.back_background}}');background-size:cover;background-position:center;font-family:Arial,sans-serif;color:#111;position:relative;padding:38px 44px;\">\n  <div style=\"position:absolute;left:0;top:0;width:156px;height:100%;background:#118eb4;\"></div>\n  <div style=\"position:absolute;right:0;bottom:0;width:330px;height:124px;background:#86ead4;\"></div>\n  <div style=\"position:relative;height:100%;display:grid;grid-template-columns:170px 1fr 210px;gap:28px;align-items:center;\">\n    <div style=\"display:grid;justify-items:center;gap:12px;color:#fff;text-align:center;\"><img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:78px;height:78px;object-fit:contain;filter:brightness(0) invert(1);\"><div style=\"font-size:15px;line-height:1.2;text-transform:uppercase;\">{{organization.name}}</div></div>\n    <div style=\"font-size:15px;line-height:1.45;display:grid;gap:12px;\"><strong style=\"font-size:22px;color:#118eb4;text-transform:uppercase;\">Card Information</strong><span>This card remains property of {{organization.name}} and must be returned if found.</span><span>{{organization.address}}<br>{{organization.phone}}<br>{{organization.email}}</span><span>Authorized by <strong>{{authorized.name}}</strong></span><div>{{authorized.signature}}</div></div>\n    <div style=\"display:grid;justify-items:center;gap:10px;text-align:center;\"><div style=\"width:150px;height:150px;display:flex;align-items:center;justify-content:center;\"><span style=\"width:104px;height:104px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span></div><div style=\"font-size:12px;text-transform:uppercase;\">Scan to validate</div><div style=\"font-size:13px;font-weight:800;\">{{card.verification_code}}</div></div>\n  </div>\n</div>",
