{
    "id": "template_20",
    "name": "light, airy body",
    "description": "light, airy body (subtle gradient instead of a flat solid fill) with the color confined to the header band and a thin accent, plus a diagonal geometric accent for visual interest.",
    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:linear-gradient(160deg,#ffffff 0%,#f3f6fb 55%,#eef2f9 100%);font-family:Arial,sans-serif;color:#1e2a3a;position:relative;\">\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:130px;background:#0f4c5c;\"></div>\n  <div style=\"position:absolute;top:0;right:0;width:258px;height:130px;background:#12a594;clip-path:polygon(45% 0,100% 0,100% 100%,0 100%);opacity:.85;\"></div>\n  <div style=\"position:absolute;top:130px;left:0;width:100%;height:3px;background:#12a594;\"></div>\n\n  <div style=\"position:relative;height:104px;padding:20px 42px 0 42px;display:flex;align-items:center;gap:20px;box-sizing:border-box;\">\n    <div style=\"width:68px;height:68px;flex:0 0 68px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#fff;border-radius:8px;padding:6px;box-sizing:border-box;\">\n      <img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain;display:block;\">\n    </div>\n    <div style=\"min-width:0;color:#fff;line-height:1.25;\">\n      <div style=\"max-width:650px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:21px;font-weight:700;letter-spacing:.3px;\">{{organization.school_name}}</div>\n      <div style=\"max-width:650px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;color:#bfe9e2;text-transform:uppercase;letter-spacing:1.5px;\">{{organization.campus_name}} &middot; Student ID</div>\n    </div>\n  </div>\n\n  <div style=\"position:relative;display:grid;grid-template-columns:178px minmax(0,1fr);gap:38px;align-items:center;padding:56px 52px 0 52px;box-sizing:border-box;\">\n    <div style=\"width:178px;height:178px;border-radius:50%;border:5px solid #ffffff;box-shadow:0 4px 14px rgba(15,76,92,.18);background:#f3f4f6;overflow:hidden;box-sizing:border-box;\">\n      <img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;max-width:100%;max-height:100%;object-fit:cover;display:block;\">\n    </div>\n    <div style=\"min-width:0;display:grid;gap:16px;align-content:center;box-sizing:border-box;\">\n      <div style=\"min-width:0;\">\n        <div style=\"max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:28px;font-weight:700;color:#0f2b33;line-height:1.1;\">{{student.full_name}}</div>\n        <div style=\"max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;line-height:1.25;color:#12a594;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-top:4px;\">{{student.program}} &middot; {{student.class_level}}</div>\n      </div>\n      <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px 24px;font-size:12.5px;line-height:1.3;color:#3d4c5a;\">\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#0f4c5c;\">Student ID</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.student_id}}</span></div>\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#0f4c5c;\">Department</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.department}}</span></div>\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#0f4c5c;\">Issued</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.issue_date}}</span></div>\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#0f4c5c;\">Valid Until</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.expiry_date}}</span></div>\n      </div>\n    </div>\n  </div>\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:linear-gradient(160deg,#ffffff 0%,#f3f6fb 55%,#eef2f9 100%);font-family:Arial,sans-serif;color:#1e2a3a;position:relative;padding:28px 50px;\">\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:16px;background:#0f4c5c;\"></div>\n\n  <div style=\"display:grid;grid-template-columns:minmax(0,1fr) 180px;gap:42px;height:100%;align-items:center;box-sizing:border-box;\">\n    <div style=\"min-width:0;display:flex;flex-direction:column;justify-content:center;gap:16px;box-sizing:border-box;\">\n      <div style=\"max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:20px;font-weight:700;color:#0f4c5c;\">{{organization.name}}</div>\n      <div style=\"max-height:78px;overflow:hidden;font-size:12.5px;line-height:1.55;color:#3d4c5a;\">{{organization.address}}<br>{{organization.phone}}<br>{{organization.email}}</div>\n      <div style=\"font-size:11.5px;line-height:1.55;color:#5b6b7a;border-top:1px solid #d7e0e8;padding-top:14px;box-sizing:border-box;\">This card remains the property of <strong>{{organization.name}}</strong>. If found, please return it to the address above.</div>\n      <div style=\"margin-top:8px;\">\n        <div style=\"width:260px;border-top:1px solid #9aa8b3;padding-top:5px;font-size:11.5px;color:#3d4c5a;box-sizing:border-box;\">{{authorized.signature}}</div>\n        <div style=\"max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10.5px;color:#6b7a87;margin-top:4px;\">{{authorized.name}} - Authorized Signatory</div>\n      </div>\n    </div>\n\n    <div style=\"width:180px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;box-sizing:border-box;\">\n      <div style=\"width:160px;height:160px;background:#ffffff;border:1px solid #d7e0e8;border-radius:12px;padding:12px;box-sizing:border-box;box-shadow:0 2px 10px rgba(15,76,92,.08);display:flex;align-items:center;justify-content:center;\">\n        <span style=\"width:136px;height:136px;display:flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;box-sizing:border-box;\">{{card.qr_code}}</span>\n      </div>\n      <span style=\"width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;color:#6b7a87;text-align:center;\">Scan to verify &middot; {{card.verification_code}}</span>\n      <span style=\"width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:9.5px;color:#9aa8b3;text-align:center;\">Serial: {{card.serial_number}}</span>\n    </div>\n  </div>\n</div>",
