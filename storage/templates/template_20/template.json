{
    "id": "template_20",
    "name": "light, airy body",
    "description": "light, airy body (subtle gradient instead of a flat solid fill) with the color confined to the header band and a thin accent, plus a diagonal geometric accent for visual interest.",
    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:linear-gradient(160deg,#ffffff 0%,#f3f6fb 55%,#eef2f9 100%);font-family:Arial,sans-serif;color:#1e2a3a;position:relative;\">\r\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:24%;background:#0f4c5c;\"></div>\r\n  <div style=\"position:absolute;top:0;right:0;width:30%;height:24%;background:#12a594;clip-path:polygon(45% 0,100% 0,100% 100%,0 100%);opacity:.85;\"></div>\r\n  <div style=\"position:absolute;top:24%;left:0;width:100%;height:3px;background:#12a594;\"></div>\r\n\r\n  <div style=\"position:relative;padding:3% 5% 0 5%;display:flex;align-items:center;gap:2.5%;height:18%;\">\r\n    <img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:9%;height:auto;aspect-ratio:1/1;object-fit:contain;background:#fff;border-radius:8px;padding:4px;\">\r\n    <div style=\"color:#fff;line-height:1.25;\">\r\n      <div style=\"font-size:1.6vw;font-weight:700;letter-spacing:.3px;\">{{organization.school_name}}</div>\r\n      <div style=\"font-size:0.9vw;color:#bfe9e2;text-transform:uppercase;letter-spacing:1.5px;\">{{organization.campus_name}} \u00b7 Student ID</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"position:relative;display:flex;padding:8% 6% 0 6%;gap:5%;align-items:center;\">\r\n    <div style=\"flex:0 0 21%;\">\r\n      <div style=\"width:100%;aspect-ratio:1/1;border-radius:50%;border:5px solid #ffffff;box-shadow:0 4px 14px rgba(15,76,92,.18);background:#f3f4f6;overflow:hidden;\">\r\n        <img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\r\n      </div>\r\n    </div>\r\n    <div style=\"flex:1;display:flex;flex-direction:column;justify-content:center;gap:2%;\">\r\n      <div>\r\n        <div style=\"font-size:2.1vw;font-weight:700;color:#0f2b33;line-height:1.1;\">{{student.full_name}}</div>\r\n        <div style=\"font-size:1vw;color:#12a594;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-top:4px;\">{{student.program}} \u00b7 {{student.class_level}}</div>\r\n      </div>\r\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:2% 4%;font-size:0.95vw;color:#3d4c5a;margin-top:3%;\">\r\n        <div><strong style=\"color:#0f4c5c;\">Student ID</strong><br>{{student.student_id}}</div>\r\n        <div><strong style=\"color:#0f4c5c;\">Department</strong><br>{{student.department}}</div>\r\n        <div><strong style=\"color:#0f4c5c;\">Issued</strong><br>{{student.issue_date}}</div>\r\n        <div><strong style=\"color:#0f4c5c;\">Valid Until</strong><br>{{student.expiry_date}}</div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:linear-gradient(160deg,#ffffff 0%,#f3f6fb 55%,#eef2f9 100%);font-family:Arial,sans-serif;color:#1e2a3a;position:relative;padding:5% 6%;\">\r\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:3%;background:#0f4c5c;\"></div>\r\n\r\n  <div style=\"display:flex;gap:5%;height:100%;align-items:center;\">\r\n    <div style=\"flex:1;display:flex;flex-direction:column;justify-content:center;gap:3%;\">\r\n      <div style=\"font-size:1.5vw;font-weight:700;color:#0f4c5c;\">{{organization.name}}</div>\r\n      <div style=\"font-size:0.95vw;line-height:1.7;color:#3d4c5a;\">\r\n        {{organization.address}}<br>\r\n        {{organization.phone}}<br>\r\n        {{organization.email}}\r\n      </div>\r\n      <div style=\"font-size:0.85vw;line-height:1.6;color:#5b6b7a;border-top:1px solid #d7e0e8;padding-top:3%;\">\r\n        This card remains the property of <strong>{{organization.name}}</strong>. If found, please return it to the address above.\r\n      </div>\r\n      <div style=\"margin-top:3%;\">\r\n        <div style=\"width:45%;border-top:1px solid #9aa8b3;padding-top:1%;font-size:0.85vw;color:#3d4c5a;\">\r\n          {{authorized.signature}}\r\n        </div>\r\n        <div style=\"font-size:0.8vw;color:#6b7a87;margin-top:2px;\">{{authorized.name}} \u2014 Authorized Signatory</div>\r\n      </div>\r\n    </div>\r\n\r\n    <div style=\"flex:0 0 22%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6%;\">\r\n      <div style=\"background:#ffffff;border:1px solid #d7e0e8;border-radius:12px;padding:8%;width:100%;box-sizing:border-box;box-shadow:0 2px 10px rgba(15,76,92,.08);display:flex;align-items:center;justify-content:center;\">\r\n        <span style=\"width:100%;aspect-ratio:1/1;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;\">{{card.qr_code}}</span>\r\n      </div>\r\n      <span style=\"font-size:0.75vw;color:#6b7a87;text-align:center;\">Scan to verify \u00b7 {{card.verification_code}}</span>\r\n      <span style=\"font-size:0.7vw;color:#9aa8b3;\">Serial: {{card.serial_number}}</span>\r\n    </div>\r\n  </div>\r\n</div>",
