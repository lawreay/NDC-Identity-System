    "front_html": "<div style=\"\r\n    width:100%;\r\n    height:100%;\r\n    box-sizing:border-box;\r\n    overflow:hidden;\r\n    position:relative;\r\n    background:#ffffff;\r\n    font-family:Arial,sans-serif;\r\n    color:#172033;\r\n\">\r\n\r\n  <!-- TOP NAVY HEADER -->\r\n  <div style=\"\r\n      position:absolute;\r\n      left:0;\r\n      top:0;\r\n      width:100%;\r\n      height:155px;\r\n      background:#06233d;\r\n  \"></div>\r\n\r\n  <!-- YELLOW ACCENT -->\r\n  <div style=\"\r\n      position:absolute;\r\n      left:0;\r\n      top:155px;\r\n      width:100%;\r\n      height:9px;\r\n      background:#ffd24a;\r\n  \"></div>\r\n\r\n  <!-- DECORATIVE CIRCLE -->\r\n  <div style=\"\r\n      position:absolute;\r\n      right:-110px;\r\n      top:-120px;\r\n      width:300px;\r\n      height:300px;\r\n      border:28px solid rgba(255,210,74,.18);\r\n      border-radius:50%;\r\n      box-sizing:border-box;\r\n  \"></div>\r\n\r\n  <!-- MAIN CONTENT -->\r\n  <div style=\"\r\n      position:relative;\r\n      width:100%;\r\n      height:100%;\r\n      padding:28px 32px 26px 32px;\r\n      box-sizing:border-box;\r\n      display:grid;\r\n      grid-template-columns:245px minmax(0,1fr);\r\n      gap:30px;\r\n      min-width:0;\r\n      min-height:0;\r\n  \">\r\n\r\n    <!-- LEFT PHOTO AREA -->\r\n    <div style=\"\r\n        min-width:0;\r\n        display:grid;\r\n        grid-template-rows:1fr auto;\r\n        justify-items:center;\r\n        align-content:center;\r\n        gap:14px;\r\n        box-sizing:border-box;\r\n    \">\r\n\r\n      <!-- PHOTO -->\r\n      <div style=\"\r\n          width:218px;\r\n          height:218px;\r\n          border-radius:16px;\r\n          overflow:hidden;\r\n          border:9px solid #ffffff;\r\n          background:#f3f4f6;\r\n          box-shadow:0 8px 22px rgba(0,0,0,.22);\r\n          box-sizing:border-box;\r\n      \">\r\n        <img\r\n          src=\"{{student.photo}}\"\r\n          alt=\"Student photo\"\r\n          style=\"\r\n              width:100%;\r\n              height:100%;\r\n              max-width:100%;\r\n              max-height:100%;\r\n              object-fit:cover;\r\n              display:block;\r\n          \"\r\n        >\r\n      </div>\r\n\r\n      <!-- STUDENT ID -->\r\n      <div style=\"\r\n          max-width:100%;\r\n          overflow:hidden;\r\n          text-overflow:ellipsis;\r\n          white-space:nowrap;\r\n          padding:8px 18px;\r\n          border-radius:20px;\r\n          background:#06233d;\r\n          color:#ffd24a;\r\n          font-size:13px;\r\n          line-height:1;\r\n          font-weight:700;\r\n          letter-spacing:1px;\r\n          box-sizing:border-box;\r\n      \">\r\n        {{student.student_id}}\r\n      </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- RIGHT INFORMATION -->\r\n    <div style=\"\r\n        min-width:0;\r\n        display:grid;\r\n        grid-template-rows:auto minmax(0,1fr) auto;\r\n        gap:18px;\r\n        box-sizing:border-box;\r\n    \">\r\n\r\n      <!-- HEADER -->\r\n      <div style=\"\r\n          min-width:0;\r\n          display:flex;\r\n          justify-content:space-between;\r\n          align-items:flex-start;\r\n          gap:20px;\r\n          box-sizing:border-box;\r\n      \">\r\n\r\n        <!-- ORGANIZATION -->\r\n        <div style=\"\r\n            min-width:0;\r\n            overflow:hidden;\r\n            padding-top:4px;\r\n        \">\r\n\r\n          <div style=\"\r\n              font-size:13px;\r\n              line-height:1.2;\r\n              font-weight:700;\r\n              text-transform:uppercase;\r\n              letter-spacing:1.8px;\r\n              color:#ffd24a;\r\n              margin-bottom:7px;\r\n          \">\r\n            Student Identity\r\n          </div>\r\n\r\n          <div style=\"\r\n              min-width:0;\r\n              max-width:100%;\r\n              overflow:hidden;\r\n              text-overflow:ellipsis;\r\n              white-space:nowrap;\r\n              font-size:18px;\r\n              line-height:1.15;\r\n              font-weight:700;\r\n              color:#ffffff;\r\n          \">\r\n            {{organization.name}}\r\n          </div>\r\n\r\n        </div>\r\n\r\n        <!-- LOGO -->\r\n        <div style=\"\r\n            width:88px;\r\n            height:88px;\r\n            min-width:88px;\r\n            border-radius:12px;\r\n            padding:8px;\r\n            background:#ffffff;\r\n            box-sizing:border-box;\r\n            box-shadow:0 5px 16px rgba(0,0,0,.18);\r\n        \">\r\n          <img\r\n            src=\"{{organization.logo}}\"\r\n            alt=\"Logo\"\r\n            style=\"\r\n                width:100%;\r\n                height:100%;\r\n                max-width:100%;\r\n                max-height:100%;\r\n                object-fit:contain;\r\n                display:block;\r\n            \"\r\n          >\r\n        </div>\r\n\r\n      </div>\r\n\r\n\r\n      <!-- STUDENT DETAILS -->\r\n      <div style=\"\r\n          min-width:0;\r\n          align-self:center;\r\n          overflow:hidden;\r\n          box-sizing:border-box;\r\n      \">\r\n\r\n        <!-- NAME -->\r\n        <div style=\"\r\n            min-width:0;\r\n            max-width:100%;\r\n            overflow:hidden;\r\n            text-overflow:ellipsis;\r\n            white-space:nowrap;\r\n            font-size:44px;\r\n            line-height:1.02;\r\n            font-weight:700;\r\n            color:#172033;\r\n            letter-spacing:-.8px;\r\n        \">\r\n          {{student.full_name}}\r\n        </div>\r\n\r\n        <!-- PROGRAM -->\r\n        <div style=\"\r\n            min-width:0;\r\n            max-width:100%;\r\n            overflow:hidden;\r\n            text-overflow:ellipsis;\r\n            white-space:nowrap;\r\n            font-size:19px;\r\n            line-height:1.25;\r\n            font-weight:600;\r\n            color:#06233d;\r\n            margin-top:10px;\r\n        \">\r\n          {{student.program}}\r\n        </div>\r\n\r\n        <!-- DEPARTMENT -->\r\n        <div style=\"\r\n            min-width:0;\r\n            max-width:100%;\r\n            overflow:hidden;\r\n            text-overflow:ellipsis;\r\n            white-space:nowrap;\r\n            font-size:14px;\r\n            line-height:1.25;\r\n            color:#6b7280;\r\n            margin-top:5px;\r\n        \">\r\n          {{student.department}}\r\n        </div>\r\n\r\n\r\n        <!-- INFORMATION CARDS -->\r\n        <div style=\"\r\n            margin-top:22px;\r\n            display:grid;\r\n            grid-template-columns:1fr 1fr;\r\n            gap:12px;\r\n            min-width:0;\r\n        \">\r\n\r\n          <div style=\"\r\n              min-width:0;\r\n              padding:11px 13px;\r\n              border-left:5px solid #ffd24a;\r\n              background:#f5f7fa;\r\n              box-sizing:border-box;\r\n              overflow:hidden;\r\n          \">\r\n            <div style=\"\r\n                font-size:10px;\r\n                line-height:1.1;\r\n                font-weight:700;\r\n                text-transform:uppercase;\r\n                letter-spacing:1px;\r\n                color:#6b7280;\r\n                margin-bottom:5px;\r\n            \">\r\n              Department\r\n            </div>\r\n\r\n            <div style=\"\r\n                min-width:0;\r\n                overflow:hidden;\r\n                text-overflow:ellipsis;\r\n                white-space:nowrap;\r\n                font-size:14px;\r\n                line-height:1.2;\r\n                font-weight:700;\r\n                color:#172033;\r\n            \">\r\n              {{student.department}}\r\n            </div>\r\n          </div>\r\n\r\n\r\n          <div style=\"\r\n              min-width:0;\r\n              padding:11px 13px;\r\n              border-left:5px solid #06233d;\r\n              background:#f5f7fa;\r\n              box-sizing:border-box;\r\n              overflow:hidden;\r\n          \">\r\n            <div style=\"\r\n                font-size:10px;\r\n                line-height:1.1;\r\n                font-weight:700;\r\n                text-transform:uppercase;\r\n                letter-spacing:1px;\r\n                color:#6b7280;\r\n                margin-bottom:5px;\r\n            \">\r\n              Valid Until\r\n            </div>\r\n\r\n            <div style=\"\r\n                font-size:14px;\r\n                line-height:1.2;\r\n                font-weight:700;\r\n                color:#172033;\r\n            \">\r\n              {{student.expiry_date}}\r\n            </div>\r\n          </div>\r\n\r\n        </div>\r\n\r\n      </div>\r\n\r\n\r\n      <!-- FOOTER / QR -->\r\n      <div style=\"\r\n          min-width:0;\r\n          display:flex;\r\n          justify-content:space-between;\r\n          align-items:center;\r\n          gap:20px;\r\n          padding-top:10px;\r\n          border-top:2px solid #e5e7eb;\r\n          box-sizing:border-box;\r\n      \">\r\n\r\n        <div style=\"\r\n            min-width:0;\r\n            max-width:calc(100% - 100px);\r\n            overflow:hidden;\r\n            text-overflow:ellipsis;\r\n            white-space:nowrap;\r\n            font-size:11px;\r\n            line-height:1.2;\r\n            font-weight:600;\r\n            color:#6b7280;\r\n        \">\r\n          {{organization.website}}\r\n        </div>\r\n\r\n        <!-- QR -->\r\n        <div style=\"\r\n            width:82px;\r\n            height:82px;\r\n            min-width:82px;\r\n            display:flex;\r\n            align-items:center;\r\n            justify-content:center;\r\n            line-height:0;\r\n            overflow:hidden;\r\n            background:#ffffff;\r\n            padding:5px;\r\n            border:2px solid #06233d;\r\n            border-radius:8px;\r\n            box-sizing:border-box;\r\n        \">\r\n          {{card.qr_code}}\r\n        </div>\r\n\r\n      </div>\r\n\r\n    </div>\r\n\r\n  </div>\r\n\r\n</div>",
    "back_html": "<div style=\"\r\n    width:100%;\r\n    height:100%;\r\n    box-sizing:border-box;\r\n    overflow:hidden;\r\n    position:relative;\r\n    background:#06233d;\r\n    font-family:Arial,sans-serif;\r\n    color:#ffffff;\r\n\">\r\n\r\n  <!-- LARGE WHITE PANEL -->\r\n  <div style=\"\r\n      position:absolute;\r\n      right:0;\r\n      top:0;\r\n      width:47%;\r\n      height:100%;\r\n      background:#ffffff;\r\n      border-radius:110px 0 0 110px;\r\n  \"></div>\r\n\r\n  <!-- YELLOW ACCENT -->\r\n  <div style=\"\r\n      position:absolute;\r\n      left:0;\r\n      bottom:0;\r\n      width:53%;\r\n      height:14px;\r\n      background:#ffd24a;\r\n  \"></div>\r\n\r\n  <!-- DECORATIVE CIRCLE -->\r\n  <div style=\"\r\n      position:absolute;\r\n      left:-140px;\r\n      bottom:-180px;\r\n      width:380px;\r\n      height:380px;\r\n      border:32px solid rgba(255,210,74,.13);\r\n      border-radius:50%;\r\n      box-sizing:border-box;\r\n  \"></div>\r\n\r\n\r\n  <!-- MAIN CONTENT -->\r\n  <div style=\"\r\n      position:relative;\r\n      width:100%;\r\n      height:100%;\r\n      padding:32px 38px;\r\n      box-sizing:border-box;\r\n      display:grid;\r\n      grid-template-columns:minmax(0,1fr) 245px;\r\n      gap:36px;\r\n      align-items:center;\r\n      min-width:0;\r\n      min-height:0;\r\n  \">\r\n\r\n\r\n    <!-- LEFT INFORMATION -->\r\n    <div style=\"\r\n        min-width:0;\r\n        max-width:100%;\r\n        display:grid;\r\n        gap:20px;\r\n        align-content:center;\r\n        box-sizing:border-box;\r\n        overflow:hidden;\r\n    \">\r\n\r\n      <!-- ORGANIZATION -->\r\n      <div style=\"\r\n          min-width:0;\r\n          max-width:100%;\r\n          overflow:hidden;\r\n          text-overflow:ellipsis;\r\n          white-space:nowrap;\r\n          font-size:28px;\r\n          line-height:1.1;\r\n          font-weight:700;\r\n          color:#ffd24a;\r\n      \">\r\n        {{organization.name}}\r\n      </div>\r\n\r\n\r\n      <!-- CONTACT DETAILS -->\r\n      <div style=\"\r\n          min-width:0;\r\n          max-width:100%;\r\n          font-size:16px;\r\n          line-height:1.6;\r\n          color:#dbeafe;\r\n          overflow:hidden;\r\n      \">\r\n        {{organization.address}}<br>\r\n        {{organization.phone}}<br>\r\n        {{organization.email}}\r\n      </div>\r\n\r\n\r\n      <!-- DIVIDER -->\r\n      <div style=\"\r\n          width:100px;\r\n          height:5px;\r\n          background:#ffd24a;\r\n          border-radius:5px;\r\n      \"></div>\r\n\r\n\r\n      <!-- CARD NOTICE -->\r\n      <div style=\"\r\n          min-width:0;\r\n          max-width:100%;\r\n          font-size:15px;\r\n          line-height:1.45;\r\n          color:#ffffff;\r\n          font-weight:600;\r\n      \">\r\n        This card is the property of the institution.\r\n        <br>\r\n        Return this card if found.\r\n      </div>\r\n\r\n\r\n      <!-- AUTHORIZATION -->\r\n      <div style=\"\r\n          min-width:0;\r\n          max-width:100%;\r\n          display:grid;\r\n          gap:9px;\r\n          box-sizing:border-box;\r\n          overflow:hidden;\r\n      \">\r\n\r\n        <!-- AUTHORIZED LABEL -->\r\n        <div style=\"\r\n            font-size:14px;\r\n            line-height:1.2;\r\n            color:#9fc3df;\r\n            font-weight:600;\r\n        \">\r\n          Authorized by\r\n        </div>\r\n\r\n\r\n        <!-- WHITE SIGNATURE BOX -->\r\n        <div style=\"\r\n            width:220px;\r\n            height:72px;\r\n            background:#ffffff;\r\n            border-radius:8px;\r\n            border:2px solid #ffd24a;\r\n            display:flex;\r\n            align-items:center;\r\n            justify-content:center;\r\n            overflow:hidden;\r\n            box-sizing:border-box;\r\n            padding:7px 12px;\r\n        \">\r\n\r\n         \r\n            {{authorized.signature}}\r\n            style=\"\r\n                width:100%;\r\n                height:100%;\r\n                max-width:100%;\r\n                max-height:100%;\r\n                object-fit:contain;\r\n                object-position:center;\r\n                display:block;\r\n            \"\r\n\r\n        </div>\r\n\r\n\r\n        <!-- AUTHORIZED NAME -->\r\n        <div style=\"\r\n            min-width:0;\r\n            max-width:220px;\r\n            overflow:hidden;\r\n            text-overflow:ellipsis;\r\n            white-space:nowrap;\r\n            font-size:15px;\r\n            line-height:1.25;\r\n            font-weight:700;\r\n            color:#ffffff;\r\n        \">\r\n          {{authorized.name}}\r\n        </div>\r\n\r\n        <!-- SIGNATURE LABEL -->\r\n        <div style=\"\r\n            font-size:9px;\r\n            line-height:1.1;\r\n            text-transform:uppercase;\r\n            letter-spacing:1.2px;\r\n            color:#9fc3df;\r\n        \">\r\n          Authorized Signature\r\n        </div>\r\n\r\n      </div>\r\n\r\n    </div>\r\n\r\n\r\n    <!-- RIGHT VERIFICATION PANEL -->\r\n    <div style=\"\r\n        width:245px;\r\n        min-width:245px;\r\n        height:100%;\r\n        display:grid;\r\n        justify-items:center;\r\n        align-content:center;\r\n        gap:18px;\r\n        color:#06233d;\r\n        text-align:center;\r\n        box-sizing:border-box;\r\n    \">\r\n\r\n      <!-- VERIFICATION TITLE -->\r\n      <div style=\"\r\n          font-size:16px;\r\n          line-height:1.1;\r\n          font-weight:700;\r\n          text-transform:uppercase;\r\n          letter-spacing:1.7px;\r\n          color:#06233d;\r\n      \">\r\n        Verify Student\r\n      </div>\r\n\r\n\r\n      <!-- LARGE QR CODE -->\r\n      <div style=\"\r\n          width:160px;\r\n          height:160px;\r\n          display:flex;\r\n          align-items:center;\r\n          justify-content:center;\r\n          line-height:0;\r\n          overflow:hidden;\r\n          padding:8px;\r\n          background:#ffffff;\r\n          border:5px solid #06233d;\r\n          border-radius:14px;\r\n          box-sizing:border-box;\r\n      \">\r\n        {{card.qr_code}}\r\n      </div>\r\n\r\n\r\n      <!-- QR INSTRUCTION -->\r\n      <div style=\"\r\n          max-width:200px;\r\n          font-size:12px;\r\n          line-height:1.4;\r\n          font-weight:600;\r\n          color:#475569;\r\n      \">\r\n        Scan the QR code to verify this student identity card.\r\n      </div>\r\n\r\n    </div>\r\n\r\n  </div>\r\n\r\n</div>",
