{
  "id": "template_8",
  "name": "Minimal Ribbon",
  "description": "Minimal white card with navy and yellow ribbon accents.",
  "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#ffffff;font-family:Arial,sans-serif;color:#172033;position:relative;\"><div style=\"position:absolute;left:0;bottom:0;width:100%;height:78px;background:#ffd24a;\"></div><div style=\"position:absolute;left:0;bottom:78px;width:58%;height:62px;background:#06233d;border-radius:0 40px 40px 0;\"></div><div style=\"position:relative;width:100%;height:100%;padding:22px;box-sizing:border-box;display:grid;grid-template-columns:1fr 172px;gap:20px;\"><div style=\"display:grid;grid-template-rows:auto 1fr auto;gap:12px;\"><div><img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:54px;height:54px;object-fit:contain;\"><div style=\"font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#6b7280;margin-top:8px;\">{{organization.name}}</div></div><div style=\"align-self:center;\"><div style=\"font-size:30px;font-weight:700;line-height:1;\">{{student.full_name}}</div><div style=\"font-size:12px;color:#6b7280;margin-top:6px;\">{{student.program}} / {{student.department}}</div></div><div style=\"font-size:10px;color:#06233d;font-weight:700;\">{{student.student_id}} &nbsp; Valid {{student.expiry_date}}</div></div><div style=\"display:grid;justify-items:center;align-content:center;gap:10px;\"><div style=\"width:142px;height:172px;border-radius:8px;overflow:hidden;border:4px solid #06233d;\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div><div style=\"font-size:9px;color:#6b7280;\">{{card.qr_code}}</div></div></div></div>",
  "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#06233d;font-family:Arial,sans-serif;color:#fff;position:relative;\"><div style=\"position:absolute;right:0;top:0;width:46%;height:100%;background:#ffffff;border-radius:100px 0 0 100px;\"></div><div style=\"position:relative;width:100%;height:100%;padding:22px;box-sizing:border-box;display:grid;grid-template-columns:1fr 210px;gap:20px;align-items:center;\"><div style=\"display:grid;gap:10px;font-size:11px;line-height:1.55;color:#dbeafe;\"><strong style=\"font-size:19px;color:#ffd24a;\">{{organization.name}}</strong><span>{{organization.address}}<br>{{organization.phone}}<br>{{organization.email}}</span><span>Return this card if found.</span><span>Authorized: <strong>{{authorized.name}}</strong></span></div><div style=\"color:#06233d;display:grid;justify-items:center;gap:10px;font-size:9px;text-align:center;\">{{card.qr_code}}Verification{{card.barcode}}</div></div></div>",
  "front_background_path": "storage/templates/template_8/front-background.png",
  "back_background_path": "storage/templates/template_8/back-background.png",
  "thumbnail_path": "storage/templates/template_8/thumbnail.png",
  "status": "active",
