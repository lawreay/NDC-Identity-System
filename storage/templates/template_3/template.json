{
    "id": "template_3",
    "name": "Modern university and corporate ID",
    "description": "completely different template. This one is inspired by modern university and corporate IDs. It uses a left color band, a dominant photo, clean typography, and a compact layout that prints well on CR80 cards.",
    "front_html": "<div style=\"\r\nwidth:100%;\r\nheight:100%;\r\nbackground:#ffffff;\r\nfont-family:Arial,Helvetica,sans-serif;\r\nposition:relative;\r\noverflow:hidden;\r\n\">\r\n\r\n<!-- Left Color Band -->\r\n<div style=\"\r\nposition:absolute;\r\nleft:0;\r\ntop:0;\r\nbottom:0;\r\nwidth:78px;\r\nbackground:{{theme.primary_color}};\r\n\"></div>\r\n\r\n<!-- Logo -->\r\n<div style=\"\r\nposition:absolute;\r\ntop:12px;\r\nleft:16px;\r\nright:16px;\r\ndisplay:flex;\r\nalign-items:center;\r\n\">\r\n\r\n<img src=\"{{organization.logo}}\" style=\"\r\nwidth:42px;\r\nheight:42px;\r\nobject-fit:contain;\r\nbackground:white;\r\nborder-radius:6px;\r\npadding:3px;\r\n\">\r\n\r\n<div style=\"margin-left:10px;\">\r\n<div style=\"\r\nfont-size:14px;\r\nfont-weight:bold;\r\ncolor:#222;\r\n\">\r\n{{organization.name}}\r\n</div>\r\n\r\n<div style=\"\r\nfont-size:10px;\r\nletter-spacing:1px;\r\ncolor:{{theme.primary_color}};\r\nfont-weight:bold;\r\n\">\r\nSTUDENT IDENTITY CARD\r\n</div>\r\n</div>\r\n\r\n</div>\r\n\r\n<!-- Photo -->\r\n<div style=\"\r\nposition:absolute;\r\nleft:14px;\r\ntop:72px;\r\nwidth:58px;\r\nheight:74px;\r\nborder-radius:8px;\r\noverflow:hidden;\r\nborder:2px solid white;\r\nbox-shadow:0 0 5px rgba(0,0,0,.25);\r\n\">\r\n\r\n<img src=\"{{student.photo}}\" style=\"\r\nwidth:100%;\r\nheight:100%;\r\nobject-fit:cover;\r\n\">\r\n\r\n</div>\r\n\r\n<!-- Student Details -->\r\n<div style=\"\r\nposition:absolute;\r\nleft:94px;\r\ntop:72px;\r\nright:12px;\r\n\">\r\n\r\n<div style=\"\r\nfont-size:18px;\r\nfont-weight:bold;\r\nline-height:20px;\r\ncolor:#111;\r\n\">\r\n{{student.full_name}}\r\n</div>\r\n\r\n<div style=\"\r\nmargin-top:6px;\r\nfont-size:11px;\r\nfont-weight:bold;\r\ncolor:{{theme.primary_color}};\r\n\">\r\n{{student.student_id}}\r\n</div>\r\n\r\n<table style=\"\r\nmargin-top:10px;\r\nfont-size:10px;\r\nwidth:100%;\r\nborder-collapse:collapse;\r\n\">\r\n\r\n<tr>\r\n<td style=\"padding:2px 0;color:#666;\">Department</td>\r\n<td><strong>{{student.department}}</strong></td>\r\n</tr>\r\n\r\n<tr>\r\n<td style=\"padding:2px 0;color:#666;\">Program</td>\r\n<td>{{student.program}}</td>\r\n</tr>\r\n\r\n<tr>\r\n<td style=\"padding:2px 0;color:#666;\">Gender</td>\r\n<td>{{student.gender}}</td>\r\n</tr>\r\n\r\n<tr>\r\n<td style=\"padding:2px 0;color:#666;\">Expires</td>\r\n<td>{{student.expiry_date}}</td>\r\n</tr>\r\n\r\n</table>\r\n\r\n</div>\r\n\r\n<!-- QR -->\r\n<div style=\"\r\nposition:absolute;\r\nleft:14px;\r\nbottom:10px;\r\nwidth:54px;\r\nheight:54px;\r\n\">\r\n{{card.qr_code}}\r\n</div>\r\n\r\n<!-- Status -->\r\n<div style=\"\r\nposition:absolute;\r\nright:12px;\r\nbottom:16px;\r\npadding:5px 10px;\r\nborder-radius:30px;\r\nbackground:#28a745;\r\ncolor:white;\r\nfont-size:10px;\r\nfont-weight:bold;\r\n\">\r\n{{student.status}}\r\n</div>\r\n\r\n</div>",
    "back_html": "<div style=\"\r\nwidth:100%;\r\nheight:100%;\r\nbackground:#ffffff;\r\nfont-family:Arial,Helvetica,sans-serif;\r\nposition:relative;\r\noverflow:hidden;\r\n\">\r\n\r\n<!-- Header -->\r\n<div style=\"\r\nbackground:{{theme.primary_color}};\r\ncolor:white;\r\npadding:12px;\r\n\">\r\n\r\n<div style=\"\r\nfont-size:15px;\r\nfont-weight:bold;\r\n\">\r\nCARD INFORMATION\r\n</div>\r\n\r\n</div>\r\n\r\n<!-- Instructions -->\r\n<div style=\"\r\npadding:12px;\r\nfont-size:10px;\r\nline-height:1.5;\r\ncolor:#222;\r\n\">\r\n\r\n<b>This card remains the property of {{organization.name}}.</b>\r\n\r\n<br><br>\r\n\r\nIf found please return it to:\r\n\r\n<br><br>\r\n\r\n<b>{{organization.name}}</b>\r\n\r\n<br>\r\n\r\n{{organization.address}}\r\n\r\n<br>\r\n\r\nPhone: {{organization.phone}}\r\n\r\n<br>\r\n\r\nEmail: {{organization.email}}\r\n\r\n<br>\r\n\r\nWebsite: {{organization.website}}\r\n\r\n</div>\r\n\r\n<!-- Signature -->\r\n<div style=\"\r\nposition:absolute;\r\nleft:14px;\r\nbottom:42px;\r\n\">\r\n\r\n<div style=\"\r\nfont-size:9px;\r\nmargin-bottom:4px;\r\n\">\r\nAuthorized Signature\r\n</div>\r\n\r\n<div>\r\n{{authorized.signature}}\r\n</div>\r\n\r\n<div style=\"\r\nborder-top:1px solid #000;\r\nwidth:120px;\r\nfont-size:9px;\r\ntext-align:center;\r\nmargin-top:2px;\r\n\">\r\n{{authorized.name}}\r\n</div>\r\n\r\n</div>\r\n\r\n<!-- Barcode -->\r\n<div style=\"\r\nposition:absolute;\r\nright:14px;\r\nbottom:42px;\r\ntext-align:center;\r\n\">\r\n\r\n<div>\r\n{{card.barcode}}\r\n</div>\r\n\r\n<div style=\"\r\nfont-size:8px;\r\nmargin-top:3px;\r\n\">\r\nVerification Barcode\r\n</div>\r\n\r\n</div>\r\n\r\n<!-- Footer -->\r\n<div style=\"\r\nposition:absolute;\r\nbottom:0;\r\nleft:0;\r\nright:0;\r\nbackground:#f5f5f5;\r\npadding:8px 12px;\r\nfont-size:9px;\r\ndisplay:flex;\r\njustify-content:space-between;\r\n\">\r\n\r\n<div>\r\nIssued: {{student.issue_date}}\r\n</div>\r\n\r\n<div>\r\nExpires: {{student.expiry_date}}\r\n</div>\r\n\r\n</div>\r\n\r\n</div>",
