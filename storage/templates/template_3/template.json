{
    "id": "template_3",
    "name": "Diagonal Slate",
    "description": "Dark diagonal sidebar with strong photo strip.",
    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#2e2f33;font-family:Arial,sans-serif;color:#f8fafc;position:relative;\">\r\n  <div style=\"position:absolute;left:-30px;top:0;width:240px;height:100%;background:#18a8d8;clip-path:polygon(0 0,70% 0,100% 100%,0 100%);\"></div><div style=\"position:absolute;left:18px;top:20px;width:138px;height:174px;border-radius:8px;overflow:hidden;border:4px solid #f8fafc;box-shadow:0 14px 26px rgba(0,0,0,.22);\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\r\n  <div style=\"position:absolute;left:210px;right:20px;top:22px;bottom:22px;display:grid;grid-template-rows:auto 1fr auto;gap:16px;\"><div style=\"display:flex;justify-content:space-between;align-items:start;\"><div><div style=\"font-size:10px;color:#7dd3fc;text-transform:uppercase;letter-spacing:1px;\">{{organization.name}}</div><div style=\"font-size:20px;font-weight:100;line-height:1.05;margin-top:6px;\">{{student.full_name}}</div><div style=\"font-size:12px;color:#cbd5e1;\">{{student.program}}</div></div><img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:58px;height:58px;object-fit:contain;background:#fff;border-radius:8px;padding:6px;box-sizing:border-box;\"></div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;align-content:center;font-size:11px;color:#e2e8f0;\"><div style=\"border-bottom:1px solid #18a8d8;padding-bottom:8px;\">Phone<br><strong>{{organization.phone}}</strong></div><div style=\"border-bottom:1px solid #18a8d8;padding-bottom:8px;\">ID<br><strong>{{student.student_id}}</strong></div><div style=\"border-bottom:1px solid #18a8d8;padding-bottom:8px;\">Department<br><strong>{{student.department}}</strong></div><div style=\"border-bottom:1px solid #18a8d8;padding-bottom:8px;\">Valid<br><strong>{{student.expiry_date}}</strong></div></div><div style=\"display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#cbd5e1;\"><span>{{organization.website}}</span><span><span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span></span></div></div>\r\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#2e2f33;font-family:Arial,sans-serif;color:#f8fafc;position:relative;padding:20px;\"><div style=\"position:absolute;right:-40px;top:0;width:280px;height:100%;background:#18a8d8;clip-path:polygon(30% 0,100% 0,100% 100%,0 100%);\"></div><div style=\"position:relative;width:100%;height:100%;display:grid;grid-template-columns:1fr 190px;gap:22px;align-items:center;\"><div style=\"display:grid;gap:12px;font-size:11px;line-height:1.55;color:#e2e8f0;\"><strong style=\"font-size:18px;color:#fff;\">Card Verification</strong><span>This ID card is non-transferable and must be presented on request.</span><span>{{organization.name}}<br>{{organization.address}}<br>{{organization.email}}</span><span>Authorized: <strong>{{authorized.name}}</strong></span></div><div style=\"background:#fff;border-radius:8px;padding:14px;display:grid;justify-items:center;gap:10px;color:#2e2f33;font-size:9px;text-align:center;\"><span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span>Scan<span style=\"width:150px;height:42px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.barcode}}</span></div></div></div>",
