{
  "id": "template_6",
  "name": "Executive Split",
  "description": "Charcoal and amber split design with circular portrait.",
  "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#111827;font-family:Arial,sans-serif;color:#f9fafb;position:relative;\"><div style=\"position:absolute;right:0;top:0;width:42%;height:100%;background:#f59e0b;\"></div><div style=\"position:absolute;right:120px;top:-80px;width:260px;height:700px;background:#ffffff;transform:skewX(-18deg);\"></div><div style=\"position:relative;width:100%;height:100%;display:grid;grid-template-columns:1fr 230px;gap:16px;padding:20px;box-sizing:border-box;\"><div style=\"display:grid;grid-template-rows:auto 1fr auto;gap:14px;\"><div><div style=\"font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#fbbf24;\">Executive Badge</div><div style=\"font-size:30px;font-weight:700;line-height:1.05;margin-top:6px;\">{{student.full_name}}</div><div style=\"font-size:12px;color:#d1d5db;\">{{student.program}}</div></div><div style=\"display:grid;gap:8px;align-content:center;font-size:11px;color:#e5e7eb;\"><div><strong>ID</strong> {{student.student_id}}</div><div><strong>Department</strong> {{student.department}}</div><div><strong>Valid Until</strong> {{student.expiry_date}}</div></div><div style=\"font-size:10px;color:#d1d5db;\">{{organization.phone}} | {{organization.website}}</div></div><div style=\"display:grid;place-items:center;\"><div style=\"width:164px;height:164px;border-radius:50%;border:10px solid #111827;background:#fff;padding:5px;box-sizing:border-box;\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;\"></div></div></div></div>",
  "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#111827;font-family:Arial,sans-serif;color:#f9fafb;padding:20px;position:relative;\"><div style=\"position:absolute;left:0;bottom:0;width:100%;height:70px;background:#f59e0b;\"></div><div style=\"position:relative;width:100%;height:100%;display:grid;grid-template-columns:1fr 170px;gap:20px;align-items:center;\"><div style=\"display:grid;gap:10px;font-size:11px;line-height:1.55;color:#d1d5db;\"><strong style=\"font-size:18px;color:#fff;\">{{organization.name}}</strong><span>{{organization.address}}<br>{{organization.phone}}<br>{{organization.email}}</span><span>Serial: {{card.serial_number}}</span><span>Authorized: <strong>{{authorized.name}}</strong></span></div><div style=\"background:#fff;color:#111827;border-radius:8px;padding:14px;display:grid;justify-items:center;gap:10px;text-align:center;font-size:9px;\">{{card.qr_code}}Secure Check{{card.barcode}}</div></div></div>",
  "front_background_path": "storage/templates/template_6/front-background.png",
  "back_background_path": "storage/templates/template_6/back-background.png",
  "thumbnail_path": "storage/templates/template_6/thumbnail.png",
