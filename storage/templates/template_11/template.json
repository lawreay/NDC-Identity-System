{
    "id": "template_11",
    "name": "Tech Grid",
    "description": "Modern tech grid with fine lines and cyan highlights.",
    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#071d33;font-family:Arial,sans-serif;color:#eef8ff;position:relative;padding:18px;\">\n  <div style=\"position:absolute;left:-80px;top:-100px;width:280px;height:280px;border:24px solid #10a8f5;border-radius:50%;opacity:.45;\"></div>\n  <div style=\"position:absolute;right:-130px;bottom:-150px;width:330px;height:330px;border:28px solid #0ea5e9;border-radius:50%;opacity:.32;\"></div>\n  <div style=\"position:relative;width:100%;height:100%;display:grid;grid-template-columns:210px 1fr;gap:22px;align-items:center;\">\n    <div style=\"display:grid;justify-items:center;gap:14px;\"><div style=\"width:154px;height:154px;border-radius:50%;border:8px solid #19b9ff;padding:6px;background:#08233e;box-sizing:border-box;\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;\"></div><div style=\"font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#8bdcff;\">{{student.student_id}}</div></div>\n    <div style=\"display:grid;gap:16px;\"><div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:20px;\"><div><div style=\"font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#8bdcff;\">Student Identity</div><div style=\"font-size:30px;line-height:1;font-weight:700;margin-top:6px;\">{{student.full_name}}</div><div style=\"font-size:13px;color:#bfd7ea;margin-top:6px;\">{{student.program}}</div></div><img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:66px;height:66px;object-fit:contain;background:#ffffff;border-radius:8px;padding:7px;box-sizing:border-box;\"></div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:11px;color:#e5f4ff;\"><div style=\"border-left:3px solid #19b9ff;padding:7px 10px;background:rgba(255,255,255,.06);\"><span style=\"color:#8bdcff;\">Dept</span><br><strong>{{student.department}}</strong></div><div style=\"border-left:3px solid #19b9ff;padding:7px 10px;background:rgba(255,255,255,.06);\"><span style=\"color:#8bdcff;\">Valid</span><br><strong>{{student.expiry_date}}</strong></div></div><div style=\"display:flex;justify-content:space-between;align-items:center;border-top:1px solid rgba(255,255,255,.18);padding-top:12px;font-size:10px;color:#bfd7ea;\"><span>{{organization.website}}</span><span><span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span></span></div></div>\n  </div>\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#071d33;font-family:Arial,sans-serif;color:#eef8ff;padding:20px;\">\n  <div style=\"width:100%;height:100%;display:grid;grid-template-columns:1fr 160px;gap:22px;align-items:center;\">\n    <div style=\"font-size:11px;line-height:1.55;color:#bfd7ea;display:grid;gap:10px;\"><strong style=\"font-size:18px;color:#fff;\">{{organization.name}}</strong><span>{{organization.address}}<br>{{organization.phone}}<br>{{organization.email}}</span><span>This card is non-transferable and must be returned if found.</span><span>Authorized by <strong>{{authorized.name}}</strong></span></div>\n    <div style=\"display:grid;justify-items:center;gap:9px;text-align:center;color:#8bdcff;font-size:9px;\"><span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span>Scan to verify<span style=\"width:150px;height:42px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.barcode}}</span></div>\n  </div>\n</div>",
    "front_background_path": "storage/templates/template_11/front-background.png",
    "back_background_path": "storage/templates/template_11/back-background.png",
    "thumbnail_path": "storage/templates/template_11/thumbnail.png",
    "status": "active",
