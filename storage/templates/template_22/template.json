    "id": "template_22",
    "name": "Voltex Regular",
    "description": "",
    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;position:relative;font-family:Arial,sans-serif;color:#12233f;background-image:url('{{template.front_background}}');background-size:cover;background-position:center;background-color:#ffffff;\">\r\n\r\n  <div style=\"position:absolute;top:5%;left:6%;display:flex;align-items:center;gap:2%;\">\r\n    <img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:8%;height:auto;object-fit:contain;\">\r\n    <div style=\"line-height:1.15;\">\r\n      <div style=\"font-size:1.4vw;font-weight:800;color:#12233f;letter-spacing:.5px;\">{{organization.name}}</div>\r\n      <div style=\"font-size:1.4vw;font-weight:800;color:#12233f;letter-spacing:.5px;\">{{organization.campus_name}}</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"position:absolute;top:26%;left:6%;font-size:2.1vw;font-weight:800;color:#12233f;letter-spacing:.5px;\">\r\n    STUDENT CARD\r\n  </div>\r\n\r\n  <div style=\"position:absolute;top:40%;left:6%;width:52%;display:grid;grid-template-columns:38% 62%;row-gap:6%;font-size:1vw;color:#12233f;\">\r\n    <div style=\"font-weight:700;\">STUDENT NAME</div><div>: {{student.full_name}}</div>\r\n    <div style=\"font-weight:700;\">STUDENT ID</div><div>: {{student.student_id}}</div>\r\n    <div style=\"font-weight:700;\">D.O.B</div><div>: {{student.date_of_birth}}</div>\r\n    <div style=\"font-weight:700;\">DEPARTMENT</div><div>: {{student.department}}</div>\r\n    <div style=\"font-weight:700;\">PROGRAM</div><div>: {{student.program}}</div>\r\n  </div>\r\n\r\n  <div style=\"position:absolute;bottom:14%;left:6%;\">\r\n    <span style=\"display:inline-flex;align-items:center;justify-content:center;width:150px;height:36px;line-height:0;overflow:hidden;\">{{card.barcode}}</span>\r\n  </div>\r\n\r\n  <div style=\"position:absolute;top:22%;right:7%;width:30%;aspect-ratio:1/1;\">\r\n    <div style=\"width:100%;height:100%;border-radius:18px;border:3px solid #12233f;overflow:hidden;box-shadow:0 6px 14px rgba(18,35,63,.2);\">\r\n      <img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\r\n    </div>\r\n  </div>\r\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;position:relative;font-family:Arial,sans-serif;color:#12233f;background-image:url('{{template.back_background}}');background-size:cover;background-position:center;background-color:#ffffff;\">\r\n\r\n  <div style=\"position:absolute;top:8%;left:7%;right:7%;font-size:1vw;line-height:1.7;color:#12233f;\">\r\n    <div style=\"font-weight:800;font-size:1.2vw;margin-bottom:2%;\">{{organization.name}}</div>\r\n    {{organization.address}}<br>\r\n    {{organization.phone}} \u00b7 {{organization.email}}\r\n  </div>\r\n\r\n  <div style=\"position:absolute;top:40%;left:7%;right:7%;font-size:0.85vw;line-height:1.6;color:#3a4a63;\">\r\n    This card remains the property of <strong>{{organization.name}}</strong>. If found, please return to the address above.\r\n  </div>\r\n\r\n  <div style=\"position:absolute;bottom:26%;left:7%;display:flex;align-items:center;gap:3%;\">\r\n    <div style=\"background:#fff;border:1px solid #d8dee6;border-radius:8px;padding:6px;\">\r\n      <span style=\"width:64px;height:64px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;\">{{card.qr_code}}</span>\r\n    </div>\r\n    <div style=\"font-size:0.8vw;color:#3a4a63;\">\r\n      Scan to verify<br>Serial: {{card.serial_number}}\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"position:absolute;bottom:8%;left:7%;font-size:0.85vw;color:#12233f;\">\r\n    <div style=\"width:160px;border-top:1px solid #12233f;padding-top:4px;\">{{authorized.name}}</div>\r\n    <div style=\"font-size:0.75vw;color:#7a8699;\">Authorized Signatory</div>\r\n  </div>\r\n</div>",
