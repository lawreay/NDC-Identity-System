    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;position:relative;font-family:Arial,sans-serif;color:#12233f;background-image:url('{{template.front_background}}');background-size:cover;background-position:center;background-color:#ffffff;\">\n  <div style=\"position:absolute;top:28px;left:52px;display:flex;align-items:center;gap:14px;box-sizing:border-box;\">\n    <div style=\"width:64px;height:64px;flex:0 0 64px;display:flex;align-items:center;justify-content:center;overflow:hidden;box-sizing:border-box;\">\n      <img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain;display:block;\">\n    </div>\n    <div style=\"line-height:1.15;min-width:0;\">\n      <div style=\"max-width:430px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:18.5px;font-weight:800;color:#12233f;letter-spacing:.5px;\">{{organization.name}}</div>\n      <div style=\"max-width:430px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:18.5px;font-weight:800;color:#12233f;letter-spacing:.5px;\">{{organization.campus_name}}</div>\n    </div>\n  </div>\n\n  <div style=\"position:absolute;top:140px;left:52px;font-size:28px;line-height:1.1;font-weight:800;color:#12233f;letter-spacing:.5px;\">STUDENT CARD</div>\n\n  <div style=\"position:absolute;top:216px;left:52px;width:448px;display:grid;grid-template-columns:150px minmax(0,1fr);row-gap:13px;column-gap:10px;font-size:13px;line-height:1.25;color:#12233f;box-sizing:border-box;\">\n    <div style=\"font-weight:700;\">STUDENT NAME</div><div style=\"min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">: {{student.full_name}}</div>\n    <div style=\"font-weight:700;\">STUDENT ID</div><div style=\"min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">: {{student.student_id}}</div>\n    <div style=\"font-weight:700;\">D.O.B</div><div style=\"min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">: {{student.date_of_birth}}</div>\n    <div style=\"font-weight:700;\">DEPARTMENT</div><div style=\"min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">: {{student.department}}</div>\n    <div style=\"font-weight:700;\">PROGRAM</div><div style=\"min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">: {{student.program}}</div>\n  </div>\n\n  <div style=\"position:absolute;bottom:76px;left:52px;\">\n    <span style=\"display:flex;align-items:center;justify-content:center;width:180px;height:48px;line-height:0;overflow:hidden;box-sizing:border-box;\">{{card.barcode}}</span>\n  </div>\n\n  <div style=\"position:absolute;top:118px;right:60px;width:238px;height:238px;border-radius:18px;border:3px solid #12233f;overflow:hidden;box-shadow:0 6px 14px rgba(18,35,63,.2);box-sizing:border-box;background:#f3f4f6;\">\n    <img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;max-width:100%;max-height:100%;object-fit:cover;display:block;\">\n  </div>\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;position:relative;font-family:Arial,sans-serif;color:#12233f;background-image:url('{{template.back_background}}');background-size:cover;background-position:center;background-color:#ffffff;\">\n  <div style=\"position:absolute;top:42px;left:60px;right:60px;font-size:13px;line-height:1.55;color:#12233f;box-sizing:border-box;\">\n    <div style=\"max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:800;font-size:16px;margin-bottom:10px;\">{{organization.name}}</div>\n    <div style=\"max-height:64px;overflow:hidden;\">{{organization.address}}<br>{{organization.phone}} &middot; {{organization.email}}</div>\n  </div>\n\n  <div style=\"position:absolute;top:216px;left:60px;right:60px;font-size:11.5px;line-height:1.6;color:#3a4a63;box-sizing:border-box;\">\n    This card remains the property of <strong>{{organization.name}}</strong>. If found, please return to the address above.\n  </div>\n\n  <div style=\"position:absolute;bottom:138px;left:60px;display:grid;grid-template-columns:82px minmax(0,220px);align-items:center;gap:18px;box-sizing:border-box;\">\n    <div style=\"width:82px;height:82px;background:#fff;border:1px solid #d8dee6;border-radius:8px;padding:8px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;\">\n      <span style=\"width:66px;height:66px;display:flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;box-sizing:border-box;\">{{card.qr_code}}</span>\n    </div>\n    <div style=\"min-width:0;font-size:10.5px;line-height:1.35;color:#3a4a63;\">\n      Scan to verify<br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">Serial: {{card.serial_number}}</span>\n    </div>\n  </div>\n\n  <div style=\"position:absolute;bottom:44px;left:60px;font-size:11.5px;color:#12233f;\">\n    <div style=\"width:180px;border-top:1px solid #12233f;padding-top:5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;box-sizing:border-box;\">{{authorized.name}}</div>\n    <div style=\"font-size:10px;color:#7a8699;margin-top:2px;\">Authorized Signatory</div>\n  </div>\n</div>",
