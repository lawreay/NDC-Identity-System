{
  "id": "template_7",
  "name": "Blue Geometry",
  "description": "Clean white layout with geometric blue blocks.",
  "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#f8fafc;font-family:Arial,sans-serif;color:#0f172a;position:relative;padding:18px;\"><div style=\"position:absolute;left:0;top:0;width:240px;height:240px;background:#dbeafe;transform:rotate(45deg);transform-origin:center;\"></div><div style=\"position:absolute;right:40px;bottom:-40px;width:180px;height:180px;background:#0f5e9c;transform:rotate(45deg);\"></div><div style=\"position:relative;width:100%;height:100%;background:#fff;border-radius:8px;border:1px solid #dbe3ea;display:grid;grid-template-columns:1fr 190px;gap:18px;padding:18px;box-sizing:border-box;\"><div style=\"display:grid;grid-template-rows:auto 1fr auto;gap:14px;\"><div><div style=\"font-size:10px;color:#0f5e9c;text-transform:uppercase;letter-spacing:1px;\">{{organization.name}}</div><div style=\"font-size:28px;font-weight:700;line-height:1.05;margin-top:6px;\">{{student.full_name}}</div><div style=\"font-size:12px;color:#64748b;\">{{student.program}}</div></div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;align-content:center;font-size:11px;\"><div><strong>ID</strong><br>{{student.student_id}}</div><div><strong>Department</strong><br>{{student.department}}</div><div><strong>Status</strong><br>{{student.status}}</div><div><strong>Expires</strong><br>{{student.expiry_date}}</div></div><div style=\"height:34px;background:#0f5e9c;color:#fff;border-radius:8px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;font-size:10px;box-sizing:border-box;\"><span>{{organization.email}}</span><span>{{card.qr_code}}</span></div></div><div style=\"display:grid;place-items:center;\"><div style=\"width:150px;height:188px;border-radius:8px;overflow:hidden;border:1px solid #cbd5e1;\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div></div></div></div>",
  "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#f8fafc;font-family:Arial,sans-serif;color:#0f172a;position:relative;padding:18px;\"><div style=\"position:absolute;right:0;top:0;width:240px;height:240px;background:#dbeafe;transform:rotate(45deg);\"></div><div style=\"position:relative;width:100%;height:100%;background:#fff;border:1px solid #dbe3ea;border-radius:8px;padding:18px;box-sizing:border-box;display:grid;grid-template-columns:1fr 170px;gap:20px;align-items:center;\"><div style=\"font-size:11px;line-height:1.55;display:grid;gap:10px;\"><strong style=\"font-size:18px;color:#0f5e9c;\">Verification Details</strong><span>{{organization.name}}<br>{{organization.address}}</span><span>{{organization.phone}}<br>{{organization.website}}</span><span>Authorized by <strong>{{authorized.name}}</strong></span></div><div style=\"display:grid;justify-items:center;gap:10px;font-size:9px;color:#64748b;text-align:center;\">{{card.qr_code}}Scan{{card.barcode}}</div></div></div>",
  "front_background_path": "storage/templates/template_7/front-background.png",
  "back_background_path": "storage/templates/template_7/back-background.png",
  "thumbnail_path": "storage/templates/template_7/thumbnail.png",
  "status": "active",
  "created_by": "Administrator",
