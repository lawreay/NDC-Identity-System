{
    "id": "template_4",
    "name": "Red Target",
    "description": "Red and white target-ring corporate layout.",
    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#ffffff;font-family:Arial,sans-serif;color:#172033;position:relative;padding:18px;\"><div style=\"position:absolute;right:-70px;top:-80px;width:280px;height:280px;background:#d51f2a;border-radius:50%;\"></div><div style=\"position:absolute;right:74px;top:36px;width:108px;height:108px;background:#fff;border:14px solid #d51f2a;border-radius:50%;\"></div><div style=\"position:relative;width:100%;height:100%;display:grid;grid-template-columns:1fr 190px;gap:18px;\"><div style=\"display:grid;grid-template-rows:auto 1fr auto;gap:14px;\"><div><div style=\"font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#d51f2a;\">{{organization.name}}</div><div style=\"font-size:28px;font-weight:700;line-height:1.05;margin-top:6px;\">{{student.full_name}}</div><div style=\"font-size:12px;color:#6b7280;\">{{student.program}}</div></div><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;align-content:center;font-size:11px;\"><div style=\"background:#f4f6f8;border-radius:8px;padding:10px;\"><strong>ID</strong><br>{{student.student_id}}</div><div style=\"background:#f4f6f8;border-radius:8px;padding:10px;\"><strong>Status</strong><br>{{student.status}}</div><div style=\"background:#f4f6f8;border-radius:8px;padding:10px;\"><strong>Department</strong><br>{{student.department}}</div><div style=\"background:#f4f6f8;border-radius:8px;padding:10px;\"><strong>Expires</strong><br>{{student.expiry_date}}</div></div><div style=\"display:flex;justify-content:space-between;align-items:center;border-top:2px solid #d51f2a;padding-top:10px;font-size:10px;color:#6b7280;\"><span>{{organization.email}}</span><span><span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span></span></div></div><div style=\"display:grid;place-items:center;\"><div style=\"width:154px;height:188px;border-radius:8px;overflow:hidden;border:5px solid #172033;box-shadow:0 10px 22px rgba(0,0,0,.16);\"><img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div></div></div></div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#d51f2a;font-family:Arial,sans-serif;color:#fff;position:relative;padding:20px;\"><div style=\"position:absolute;right:-90px;top:-80px;width:300px;height:300px;background:#fff;border-radius:50%;\"></div><div style=\"position:relative;width:100%;height:100%;display:grid;grid-template-columns:1fr 190px;gap:22px;align-items:center;\"><div style=\"display:grid;gap:12px;font-size:11px;line-height:1.5;\"><strong style=\"font-size:19px;\">{{organization.name}}</strong><span>{{organization.address}}</span><span>{{organization.phone}}<br>{{organization.email}}</span><span>This card is valid until <strong>{{student.expiry_date}}</strong>.</span></div><div style=\"background:#fff;color:#172033;border-radius:8px;padding:14px;display:grid;justify-items:center;gap:10px;text-align:center;font-size:9px;\"><span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span>Verify<span style=\"width:150px;height:42px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.barcode}}</span></div></div></div>",
    "front_background_path": "storage/templates/template_4/front-background.png",
    "back_background_path": "storage/templates/template_4/back-background.png",
