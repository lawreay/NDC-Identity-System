    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:linear-gradient(135deg,#fffdfa 0%,#faf6ef 60%,#f6f0e6 100%);font-family:Arial,sans-serif;color:#2b2620;position:relative;\">\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:118px;background:#1c1a17;\"></div>\n  <div style=\"position:absolute;top:118px;left:0;width:100%;height:2px;background:#c9a24b;\"></div>\n  <div style=\"position:absolute;top:0;left:0;width:6px;height:100%;background:#c9a24b;\"></div>\n\n  <div style=\"position:relative;height:94px;padding:18px 42px 0 52px;display:flex;align-items:center;gap:20px;box-sizing:border-box;\">\n    <div style=\"width:64px;height:64px;flex:0 0 64px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#fff;border-radius:6px;padding:6px;box-sizing:border-box;\">\n      <img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain;display:block;\">\n    </div>\n    <div style=\"min-width:0;color:#f7ecd8;line-height:1.25;\">\n      <div style=\"max-width:660px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:20.5px;font-weight:700;letter-spacing:.8px;\">{{organization.school_name}}</div>\n      <div style=\"max-width:660px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;color:#c9a24b;text-transform:uppercase;letter-spacing:2px;margin-top:2px;\">{{organization.campus_name}}</div>\n    </div>\n  </div>\n\n  <div style=\"position:relative;display:grid;grid-template-columns:minmax(0,1fr) 168px;gap:34px;align-items:center;padding:54px 48px 0 52px;box-sizing:border-box;\">\n    <div style=\"min-width:0;display:grid;gap:16px;align-content:center;box-sizing:border-box;\">\n      <div style=\"min-width:0;\">\n        <div style=\"font-size:10px;line-height:1.2;color:#c9a24b;text-transform:uppercase;letter-spacing:2px;font-weight:600;\">Student Identification</div>\n        <div style=\"max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:28px;font-weight:700;color:#1c1a17;line-height:1.15;margin-top:4px;\">{{student.full_name}}</div>\n        <div style=\"max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12.5px;line-height:1.25;color:#7a6f5e;font-weight:600;margin-top:2px;\">{{student.program}} &middot; {{student.class_level}}</div>\n      </div>\n      <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px 24px;font-size:12px;line-height:1.3;color:#4a4338;border-top:1px solid #e4d9c2;padding-top:18px;box-sizing:border-box;\">\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#c9a24b;\">Student ID</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.student_id}}</span></div>\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#c9a24b;\">Department</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.department}}</span></div>\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#c9a24b;\">Issued</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.issue_date}}</span></div>\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#c9a24b;\">Valid Until</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.expiry_date}}</span></div>\n      </div>\n    </div>\n\n    <div style=\"width:168px;height:224px;border-radius:10px;border:3px solid #c9a24b;box-shadow:0 6px 16px rgba(28,26,23,.15);background:#f3f4f6;overflow:hidden;box-sizing:border-box;\">\n      <img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;max-width:100%;max-height:100%;object-fit:cover;display:block;\">\n    </div>\n  </div>\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:linear-gradient(135deg,#fffdfa 0%,#faf6ef 60%,#f6f0e6 100%);font-family:Arial,sans-serif;color:#2b2620;position:relative;padding:28px 48px 28px 56px;\">\n  <div style=\"position:absolute;top:0;left:0;width:6px;height:100%;background:#c9a24b;\"></div>\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:2px;background:#c9a24b;\"></div>\n\n  <div style=\"display:grid;grid-template-columns:180px minmax(0,1fr);gap:42px;height:100%;align-items:center;box-sizing:border-box;\">\n    <div style=\"width:180px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;box-sizing:border-box;\">\n      <div style=\"width:160px;height:160px;background:#ffffff;border:1px solid #e4d9c2;border-radius:10px;padding:12px;box-sizing:border-box;box-shadow:0 3px 12px rgba(28,26,23,.08);display:flex;align-items:center;justify-content:center;\">\n        <span style=\"width:136px;height:136px;display:flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;box-sizing:border-box;\">{{card.qr_code}}</span>\n      </div>\n      <span style=\"width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;color:#7a6f5e;text-align:center;\">Scan to verify &middot; {{card.verification_code}}</span>\n      <span style=\"width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:9.5px;color:#a89a80;text-align:center;\">Serial: {{card.serial_number}}</span>\n    </div>\n\n    <div style=\"min-width:0;display:flex;flex-direction:column;justify-content:center;gap:16px;box-sizing:border-box;\">\n      <div style=\"max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:18.5px;font-weight:700;color:#1c1a17;\">{{organization.name}}</div>\n      <div style=\"max-height:78px;overflow:hidden;font-size:12px;line-height:1.6;color:#4a4338;\">{{organization.address}}<br>{{organization.phone}}<br>{{organization.email}}</div>\n      <div style=\"font-size:11.5px;line-height:1.55;color:#7a6f5e;border-top:1px solid #e4d9c2;padding-top:14px;box-sizing:border-box;\">This card remains the property of <strong>{{organization.name}}</strong>. If found, please return it to the address above.</div>\n      <div style=\"margin-top:8px;\">\n        <div style=\"width:260px;border-top:1px solid #c9a24b;padding-top:5px;font-size:11.5px;color:#4a4338;box-sizing:border-box;\">{{authorized.signature}}</div>\n        <div style=\"max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10.5px;color:#7a6f5e;margin-top:4px;\">{{authorized.name}} - Authorized Signatory</div>\n      </div>\n    </div>\n  </div>\n</div>",
