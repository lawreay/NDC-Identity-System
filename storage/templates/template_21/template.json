    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:linear-gradient(135deg,#fffdfa 0%,#faf6ef 60%,#f6f0e6 100%);font-family:Arial,sans-serif;color:#2b2620;position:relative;\">\r\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:22%;background:#1c1a17;\"></div>\r\n  <div style=\"position:absolute;top:22%;left:0;width:100%;height:2px;background:#c9a24b;\"></div>\r\n  <div style=\"position:absolute;top:0;left:0;width:6px;height:100%;background:#c9a24b;\"></div>\r\n\r\n  <div style=\"position:relative;padding:3% 5% 0 6%;display:flex;align-items:center;gap:2.5%;height:16%;\">\r\n    <img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:8.5%;height:auto;aspect-ratio:1/1;object-fit:contain;background:#fff;border-radius:6px;padding:4px;\">\r\n    <div style=\"color:#f7ecd8;line-height:1.25;\">\r\n      <div style=\"font-size:20.15px;font-weight:700;letter-spacing:.8px;\">{{organization.school_name}}</div>\r\n      <div style=\"font-size:11.05px;color:#c9a24b;text-transform:uppercase;letter-spacing:2px;margin-top:2px;\">{{organization.campus_name}}</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"position:relative;display:flex;padding:7% 5% 0 6%;gap:4%;align-items:center;\">\r\n    <div style=\"flex:1;display:flex;flex-direction:column;justify-content:center;gap:2.5%;\">\r\n      <div>\r\n        <div style=\"font-size:9.75px;color:#c9a24b;text-transform:uppercase;letter-spacing:2px;font-weight:600;\">Student Identification</div>\r\n        <div style=\"font-size:27.3px;font-weight:700;color:#1c1a17;line-height:1.15;margin-top:4px;\">{{student.full_name}}</div>\r\n        <div style=\"font-size:12.35px;color:#7a6f5e;font-weight:600;margin-top:2px;\">{{student.program}} \u00b7 {{student.class_level}}</div>\r\n      </div>\r\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:2.5% 4%;font-size:11.7px;color:#4a4338;margin-top:4%;border-top:1px solid #e4d9c2;padding-top:4%;\">\r\n        <div><strong style=\"color:#c9a24b;\">Student ID</strong><br>{{student.student_id}}</div>\r\n        <div><strong style=\"color:#c9a24b;\">Department</strong><br>{{student.department}}</div>\r\n        <div><strong style=\"color:#c9a24b;\">Issued</strong><br>{{student.issue_date}}</div>\r\n        <div><strong style=\"color:#c9a24b;\">Valid Until</strong><br>{{student.expiry_date}}</div>\r\n      </div>\r\n    </div>\r\n\r\n    <div style=\"flex:0 0 24%;\">\r\n      <div style=\"width:100%;aspect-ratio:3/4;border-radius:10px;border:3px solid #c9a24b;box-shadow:0 6px 16px rgba(28,26,23,.15);background:#f3f4f6;overflow:hidden;\">\r\n        <img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:linear-gradient(135deg,#fffdfa 0%,#faf6ef 60%,#f6f0e6 100%);font-family:Arial,sans-serif;color:#2b2620;position:relative;padding:5% 6%;\">\r\n  <div style=\"position:absolute;top:0;left:0;width:6px;height:100%;background:#c9a24b;\"></div>\r\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:2px;background:#c9a24b;\"></div>\r\n\r\n  <div style=\"display:flex;gap:5%;height:100%;align-items:center;\">\r\n    <div style=\"flex:0 0 24%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6%;\">\r\n      <div style=\"background:#ffffff;border:1px solid #e4d9c2;border-radius:10px;padding:8%;width:100%;box-sizing:border-box;box-shadow:0 3px 12px rgba(28,26,23,.08);display:flex;align-items:center;justify-content:center;\">\r\n        <span style=\"width:100%;aspect-ratio:1/1;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;\">{{card.qr_code}}</span>\r\n      </div>\r\n      <span style=\"font-size:9.75px;color:#7a6f5e;text-align:center;\">Scan to verify \u00b7 {{card.verification_code}}</span>\r\n      <span style=\"font-size:9.1px;color:#a89a80;\">Serial: {{card.serial_number}}</span>\r\n    </div>\r\n\r\n    <div style=\"flex:1;display:flex;flex-direction:column;justify-content:center;gap:3%;\">\r\n      <div style=\"font-size:18.2px;font-weight:700;color:#1c1a17;\">{{organization.name}}</div>\r\n      <div style=\"font-size:11.7px;line-height:1.7;color:#4a4338;\">\r\n        {{organization.address}}<br>\r\n        {{organization.phone}}<br>\r\n        {{organization.email}}\r\n      </div>\r\n      <div style=\"font-size:11.05px;line-height:1.6;color:#7a6f5e;border-top:1px solid #e4d9c2;padding-top:3%;\">\r\n        This card remains the property of <strong>{{organization.name}}</strong>. If found, please return it to the address above.\r\n      </div>\r\n      <div style=\"margin-top:3%;\">\r\n        <div style=\"width:45%;border-top:1px solid #c9a24b;padding-top:1%;font-size:11.05px;color:#4a4338;\">\r\n          {{authorized.signature}}\r\n        </div>\r\n        <div style=\"font-size:10.4px;color:#7a6f5e;margin-top:2px;\">{{authorized.name}} \u2014 Authorized Signatory</div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>",
