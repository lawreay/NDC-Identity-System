    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#f7fbfb;background-image:url('{{template.front_background}}');background-size:cover;background-position:center;font-family:Arial,sans-serif;color:#1f2937;padding:14px;\">\n  <div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:rgba(255,255,255,0.96);border:1px solid #d9e2ef;border-radius:8px;display:grid;grid-template-columns:178px 1fr;\">\n    <div style=\"height:100%;box-sizing:border-box;background:#0f3d3e;padding:16px;display:grid;grid-template-rows:auto 1fr auto;gap:12px;color:#fff;\">\n      <div>\n        <img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:54px;height:54px;object-fit:contain;background:#fff;border-radius:8px;padding:6px;box-sizing:border-box;\">\n        <div style=\"font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#d6f1ee;margin-top:10px;\">{{organization.name}}</div>\n      </div>\n      <div style=\"align-self:center;width:132px;height:166px;border-radius:8px;overflow:hidden;border:3px solid #d6f1ee;background:#fff;\">\n        <img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\n      </div>\n      <div style=\"font-size:9px;line-height:1.35;color:#e5e7eb;\">Issued {{student.issue_date}}<br>Expires {{student.expiry_date}}</div>\n    </div>\n    <div style=\"height:100%;box-sizing:border-box;padding:18px 20px;display:grid;grid-template-rows:auto 1fr auto;gap:14px;\">\n      <div style=\"display:flex;justify-content:space-between;gap:16px;align-items:flex-start;border-bottom:1px solid #e5e7eb;padding-bottom:10px;\">\n        <div>\n          <div style=\"font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#6b7280;\">Student Identity Card</div>\n          <div style=\"font-size:22px;line-height:1.05;font-weight:700;color:#0f3d3e;margin-top:5px;\">{{student.full_name}}</div>\n          <div style=\"font-size:11px;color:#4b5563;margin-top:4px;\">{{student.program}}</div>\n        </div>\n        <div style=\"background:#d6f1ee;color:#0f3d3e;border-radius:999px;padding:5px 10px;font-size:10px;font-weight:700;text-transform:uppercase;white-space:nowrap;\">{{student.status}}</div>\n      </div>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;align-content:center;font-size:11px;color:#374151;\">\n        <div style=\"border:1px solid #e5e7eb;border-radius:8px;padding:10px;background:#fff;\"><div style=\"font-size:8px;text-transform:uppercase;color:#6b7280;\">Student ID</div><strong>{{student.student_id}}</strong></div>\n        <div style=\"border:1px solid #e5e7eb;border-radius:8px;padding:10px;background:#fff;\"><div style=\"font-size:8px;text-transform:uppercase;color:#6b7280;\">Department</div><strong>{{student.department}}</strong></div>\n        <div style=\"border:1px solid #e5e7eb;border-radius:8px;padding:10px;background:#fff;\"><div style=\"font-size:8px;text-transform:uppercase;color:#6b7280;\">Qualification</div><strong>{{student.qualification}}</strong></div>\n        <div style=\"border:1px solid #e5e7eb;border-radius:8px;padding:10px;background:#fff;\"><div style=\"font-size:8px;text-transform:uppercase;color:#6b7280;\">Class Level</div><strong>{{student.class_level}}</strong></div>\n      </div>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px solid #e5e7eb;padding-top:10px;\">\n        <div style=\"font-size:10px;color:#4b5563;line-height:1.35;\">{{organization.phone}}<br>{{organization.email}}</div>\n        <div style=\"display:flex;align-items:center;gap:8px;font-size:9px;color:#6b7280;text-transform:uppercase;letter-spacing:1px;\">Verify {{card.qr_code}}</div>\n      </div>\n    </div>\n  </div>\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#f7fbfb;background-image:url('{{template.back_background}}');background-size:cover;background-position:center;font-family:Arial,sans-serif;color:#1f2937;padding:14px;\">\n  <div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:rgba(255,255,255,0.97);border:1px solid #d9e2ef;border-radius:8px;display:grid;grid-template-rows:auto 1fr auto;gap:12px;padding:18px;\">\n    <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:18px;border-bottom:1px solid #e5e7eb;padding-bottom:10px;\">\n      <div>\n        <div style=\"font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#6b7280;\">Card Terms</div>\n        <div style=\"font-size:17px;font-weight:700;color:#0f3d3e;margin-top:4px;\">{{organization.name}}</div>\n      </div>\n      <div style=\"font-size:10px;color:#4b5563;text-align:right;line-height:1.35;\">{{organization.phone}}<br>{{organization.email}}</div>\n    </div>\n    <div style=\"display:grid;grid-template-columns:1fr 150px;gap:18px;align-items:center;\">\n      <div style=\"display:grid;gap:10px;font-size:11px;line-height:1.45;color:#374151;\">\n        <div style=\"background:#f7fbfb;border-left:5px solid #d6f1ee;border-radius:8px;padding:12px;\">This card is the property of {{organization.name}}. If found, please return it to the address shown below.</div>\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;\">\n          <div><div style=\"font-size:8px;text-transform:uppercase;color:#6b7280;\">Address</div><strong>{{organization.address}}</strong></div>\n          <div><div style=\"font-size:8px;text-transform:uppercase;color:#6b7280;\">Website</div><strong>{{organization.website}}</strong></div>\n          <div><div style=\"font-size:8px;text-transform:uppercase;color:#6b7280;\">Student ID</div><strong>{{student.student_id}}</strong></div>\n          <div><div style=\"font-size:8px;text-transform:uppercase;color:#6b7280;\">Valid Until</div><strong>{{student.expiry_date}}</strong></div>\n        </div>\n      </div>\n      <div style=\"display:grid;justify-items:center;gap:8px;color:#6b7280;font-size:9px;text-align:center;\">\n        {{card.qr_code}}\n        <div>Scan to verify</div>\n        {{card.barcode}}\n      </div>\n    </div>\n    <div style=\"display:flex;justify-content:space-between;align-items:end;gap:16px;border-top:1px solid #e5e7eb;padding-top:10px;font-size:10px;color:#4b5563;\">\n      <div>{{authorized.signature}}<br><strong>{{authorized.name}}</strong><br><span style=\"color:#6b7280;\">Authorized Signatory</span></div>\n      <div style=\"text-align:right;color:#0f3d3e;font-weight:700;\">Secure Student Identity</div>\n    </div>\n  </div>\n</div>",
