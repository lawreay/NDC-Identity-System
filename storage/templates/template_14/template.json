    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;background:#eef3f8;padding:14px;font-family:Segoe UI,Arial,sans-serif;\">\r\n  <div style=\"height:100%;border-radius:16px;overflow:hidden;background:#fff;box-shadow:0 12px 28px rgba(0,0,0,.12);display:grid;grid-template-columns:150px 1fr;\">\r\n\r\n    <!-- Left -->\r\n    <div style=\"background:linear-gradient(180deg,#0F3D66,#0B6CB8);padding:18px;color:#fff;display:flex;flex-direction:column;align-items:center;\">\r\n\r\n      <img src=\"{{organization.logo}}\" style=\"width:56px;height:56px;background:#fff;padding:6px;border-radius:12px;object-fit:contain;\">\r\n\r\n      <div style=\"margin-top:12px;text-align:center;font-size:11px;font-weight:700;line-height:1.4;text-transform:uppercase;\">\r\n        {{organization.name}}\r\n      </div>\r\n\r\n      <div style=\"margin-top:18px;width:105px;height:130px;border-radius:14px;overflow:hidden;background:#fff;border:3px solid rgba(255,255,255,.4);\">\r\n        <img src=\"{{student.photo}}\" style=\"width:100%;height:100%;object-fit:cover;\">\r\n      </div>\r\n\r\n      <div style=\"margin-top:auto;text-align:center;font-size:10px;line-height:1.6;\">\r\n        <div>ID: <strong>{{student.student_id}}</strong></div>\r\n        <div>Valid Until</div>\r\n        <strong>{{student.expiry_date}}</strong>\r\n      </div>\r\n\r\n    </div>\r\n\r\n    <!-- Right -->\r\n    <div style=\"padding:22px;display:grid;grid-template-rows:auto auto 1fr auto;\">\r\n\r\n      <div style=\"display:flex;justify-content:space-between;align-items:center;\">\r\n\r\n        <div>\r\n          <div style=\"font-size:11px;color:#6b7280;letter-spacing:2px;text-transform:uppercase;\">\r\n            Student Identity Card\r\n          </div>\r\n\r\n          <div style=\"font-size:28px;font-weight:700;color:#0F3D66;margin-top:6px;\">\r\n            {{student.full_name}}\r\n          </div>\r\n\r\n          <div style=\"font-size:13px;color:#4b5563;margin-top:3px;\">\r\n            {{student.program}}\r\n          </div>\r\n        </div>\r\n\r\n        <div style=\"background:#DCFCE7;color:#166534;padding:6px 14px;border-radius:30px;font-size:11px;font-weight:700;\">\r\n          {{student.status}}\r\n        </div>\r\n\r\n      </div>\r\n\r\n      <div style=\"margin-top:20px;height:2px;background:#E5E7EB;\"></div>\r\n\r\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:22px;\">\r\n\r\n        <div>\r\n          <div style=\"font-size:10px;color:#9CA3AF;\">Department</div>\r\n          <div style=\"font-weight:600;\">{{student.department}}</div>\r\n        </div>\r\n\r\n        <div>\r\n          <div style=\"font-size:10px;color:#9CA3AF;\">Qualification</div>\r\n          <div style=\"font-weight:600;\">{{student.qualification}}</div>\r\n        </div>\r\n\r\n        <div>\r\n          <div style=\"font-size:10px;color:#9CA3AF;\">Class Level</div>\r\n          <div style=\"font-weight:600;\">{{student.class_level}}</div>\r\n        </div>\r\n\r\n        <div>\r\n          <div style=\"font-size:10px;color:#9CA3AF;\">Issue Date</div>\r\n          <div style=\"font-weight:600;\">{{student.issue_date}}</div>\r\n        </div>\r\n\r\n      </div>\r\n\r\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-end;\">\r\n\r\n        <div style=\"font-size:11px;color:#6b7280;\">\r\n          {{organization.phone}}<br>\r\n          {{organization.email}}\r\n        </div>\r\n\r\n        <div style=\"text-align:center;\">\r\n          <span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span>\r\n          <div style=\"font-size:9px;color:#6b7280;margin-top:5px;\">\r\n            Verify Card\r\n          </div>\r\n        </div>\r\n\r\n      </div>\r\n\r\n    </div>\r\n\r\n  </div>\r\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;background:#eef3f8;padding:14px;font-family:Segoe UI,Arial,sans-serif;\">\r\n\r\n<div style=\"height:100%;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 12px 28px rgba(0,0,0,.12);display:grid;grid-template-rows:auto 1fr auto;\">\r\n\r\n<!-- Header -->\r\n\r\n<div style=\"background:linear-gradient(90deg,#0F3D66,#0B6CB8);padding:18px 24px;color:white;display:flex;justify-content:space-between;align-items:center;\">\r\n\r\n<div>\r\n\r\n<div style=\"font-size:20px;font-weight:700;\">\r\n{{organization.name}}\r\n</div>\r\n\r\n<div style=\"font-size:11px;opacity:.85;\">\r\nStudent Identification Card\r\n</div>\r\n\r\n</div>\r\n\r\n<img src=\"{{organization.logo}}\" style=\"width:46px;height:46px;background:white;border-radius:10px;padding:5px;\">\r\n\r\n</div>\r\n\r\n<!-- Body -->\r\n\r\n<div style=\"padding:22px;display:grid;grid-template-columns:1fr 170px;gap:30px;\">\r\n\r\n<div>\r\n\r\n<div style=\"background:#F9FAFB;border-left:5px solid #0B6CB8;padding:16px;border-radius:10px;font-size:12px;line-height:1.6;color:#374151;\">\r\nThis card remains the property of <strong>{{organization.name}}</strong>.\r\nIf found, kindly return it to the address below.\r\n</div>\r\n\r\n<div style=\"margin-top:24px;display:grid;grid-template-columns:1fr 1fr;gap:18px;\">\r\n\r\n<div>\r\n\r\n<div style=\"font-size:10px;color:#9CA3AF;\">Address</div>\r\n\r\n<div style=\"font-weight:600;\">\r\n{{organization.address}}\r\n</div>\r\n\r\n</div>\r\n\r\n<div>\r\n\r\n<div style=\"font-size:10px;color:#9CA3AF;\">Website</div>\r\n\r\n<div style=\"font-weight:600;\">\r\n{{organization.website}}\r\n</div>\r\n\r\n</div>\r\n\r\n<div>\r\n\r\n<div style=\"font-size:10px;color:#9CA3AF;\">Student ID</div>\r\n\r\n<div style=\"font-weight:600;\">\r\n{{student.student_id}}\r\n</div>\r\n\r\n</div>\r\n\r\n<div>\r\n\r\n<div style=\"font-size:10px;color:#9CA3AF;\">Expires</div>\r\n\r\n<div style=\"font-weight:600;\">\r\n{{student.expiry_date}}\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n<div style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;\">\r\n\r\n<span style=\"width:54px;height:54px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.qr_code}}</span>\r\n\r\n<div style=\"font-size:10px;color:#6b7280;\">\r\nScan to Verify\r\n</div>\r\n\r\n<span style=\"width:150px;height:42px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;vertical-align:middle;\">{{card.barcode}}</span>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n<!-- Footer -->\r\n\r\n<div style=\"padding:18px 24px;border-top:1px solid #E5E7EB;display:flex;justify-content:space-between;align-items:center;\">\r\n\r\n<div>\r\n\r\n{{authorized.signature}}\r\n\r\n<div style=\"font-weight:700;\">\r\n{{authorized.name}}\r\n</div>\r\n\r\n<div style=\"font-size:10px;color:#6b7280;\">\r\nAuthorized Signatory\r\n</div>\r\n\r\n</div>\r\n\r\n<div style=\"font-size:11px;color:#6b7280;text-align:right;\">\r\n\r\n{{organization.phone}}<br>\r\n\r\n{{organization.email}}\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n</div>",
