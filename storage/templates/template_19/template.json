    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#ffffff;font-family:Arial,sans-serif;color:#1f2937;position:relative;\">\r\n\r\n  <!-- Header -->\r\n\r\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:20%;background:#7f1d1d;\"></div>\r\n  <div style=\"position:absolute;top:20%;left:0;width:100%;height:1.5%;background:#f2c14e;\"></div>\r\n\r\n  <!-- Logo + Institution -->\r\n\r\n  <div style=\"\r\n      position:relative;\r\n      padding:3% 4% 0 4%;\r\n      display:flex;\r\n      align-items:center;\r\n      gap:2.5%;\r\n      height:17%;\r\n  \">\r\n\r\n<img\r\n  src=\"{{organization.logo}}\"\r\n  alt=\"Logo\"\r\n  style=\"\r\n      width:12%;\r\n      height:auto;\r\n      aspect-ratio:1/1;\r\n      object-fit:contain;\r\n      background:#fff;\r\n      border-radius:8px;\r\n      padding:4px;\r\n  \"\r\n>\r\n\r\n<div style=\"\r\n    color:#fff;\r\n    line-height:1.25;\r\n\">\r\n\r\n  <div style=\"\r\n      font-size:24px;\r\n      font-weight:700;\r\n      letter-spacing:.5px;\r\n  \">\r\n    {{organization.school_name}}\r\n  </div>\r\n\r\n  <div style=\"\r\n      font-size:13px;\r\n      color:#fcd9a0;\r\n      text-transform:uppercase;\r\n      letter-spacing:1.5px;\r\n      margin-top:3px;\r\n  \">\r\n    {{organization.campus_name}} \u00b7 Student ID\r\n  </div>\r\n\r\n</div>\r\n\r\n  </div>\r\n\r\n  <!-- Student Information -->\r\n\r\n  <div style=\"\r\n      position:relative;\r\n      display:flex;\r\n      align-items:center;\r\n      padding:5% 5% 0 5%;\r\n      gap:5%;\r\n  \">\r\n\r\n<!-- Student Photo -->\r\n<div style=\"\r\n    flex:0 0 23%;\r\n\">\r\n\r\n  <div style=\"\r\n      width:100%;\r\n      aspect-ratio:1/1;\r\n      border-radius:14px;\r\n      border:5px solid #7f1d1d;\r\n      background:#f3f4f6;\r\n      overflow:hidden;\r\n      box-sizing:border-box;\r\n  \">\r\n\r\n    <img\r\n      src=\"{{student.photo}}\"\r\n      alt=\"Student photo\"\r\n      style=\"\r\n          width:100%;\r\n          height:100%;\r\n          object-fit:cover;\r\n          display:block;\r\n      \"\r\n    >\r\n\r\n  </div>\r\n\r\n</div>\r\n\r\n\r\n<!-- Student Details -->\r\n<div style=\"\r\n    flex:1;\r\n    min-width:0;\r\n    display:flex;\r\n    flex-direction:column;\r\n    justify-content:center;\r\n    gap:2%;\r\n\">\r\n\r\n  <!-- Name + Programme -->\r\n  <div>\r\n\r\n    <div style=\"\r\n        font-size:32px;\r\n        font-weight:700;\r\n        color:#111827;\r\n        line-height:1.1;\r\n        white-space:nowrap;\r\n        overflow:hidden;\r\n        text-overflow:ellipsis;\r\n    \">\r\n      {{student.full_name}}\r\n    </div>\r\n\r\n    <div style=\"\r\n        font-size:15px;\r\n        color:#7f1d1d;\r\n        font-weight:600;\r\n        text-transform:uppercase;\r\n        letter-spacing:.5px;\r\n        margin-top:6px;\r\n    \">\r\n      {{student.program}} \u00b7 {{student.class_level}}\r\n    </div>\r\n\r\n  </div>\r\n\r\n\r\n  <!-- Student Metadata -->\r\n  <div style=\"\r\n      display:grid;\r\n      grid-template-columns:1fr 1fr;\r\n      gap:2% 4%;\r\n      font-size:14px;\r\n      color:#374151;\r\n      margin-top:3%;\r\n  \">\r\n\r\n    <div>\r\n      <strong style=\"color:#7f1d1d;\">Student ID</strong><br>\r\n      {{student.student_id}}\r\n    </div>\r\n\r\n    <div>\r\n      <strong style=\"color:#7f1d1d;\">Department</strong><br>\r\n      {{student.department}}\r\n    </div>\r\n\r\n    <div>\r\n      <strong style=\"color:#7f1d1d;\">Issued</strong><br>\r\n      {{student.issue_date}}\r\n    </div>\r\n\r\n    <div>\r\n      <strong style=\"color:#7f1d1d;\">Valid Until</strong><br>\r\n      {{student.expiry_date}}\r\n    </div>\r\n\r\n  </div>\r\n\r\n</div>\r\n\r\n  </div>\r\n\r\n  <!-- Bottom Accent -->\r\n\r\n  <div style=\"\r\n      position:absolute;\r\n      bottom:0;\r\n      left:0;\r\n      width:100%;\r\n      height:2.5%;\r\n      background:#7f1d1d;\r\n  \"></div>\r\n\r\n</div>\r\n",
    "back_html": "<div style=\"\r\n    width:100%;\r\n    height:100%;\r\n    box-sizing:border-box;\r\n    overflow:hidden;\r\n    background:#ffffff;\r\n    font-family:Arial,sans-serif;\r\n    color:#1f2937;\r\n    position:relative;\r\n    padding:24px 46px;\r\n\">\r\n\r\n  <!-- Top accent -->\r\n\r\n  <div style=\"\r\n      position:absolute;\r\n      top:0;\r\n      left:0;\r\n      width:100%;\r\n      height:15px;\r\n      background:#f2c14e;\r\n  \"></div>\r\n\r\n  <!-- Main content -->\r\n\r\n  <div style=\"\r\n      display:flex;\r\n      gap:44px;\r\n      width:100%;\r\n      height:100%;\r\n      align-items:center;\r\n  \">\r\n\r\n<!-- LEFT INFORMATION -->\r\n<div style=\"\r\n    flex:1;\r\n    min-width:0;\r\n    height:100%;\r\n    display:flex;\r\n    flex-direction:column;\r\n    justify-content:center;\r\n    gap:18px;\r\n\">\r\n\r\n  <!-- Organization -->\r\n  <div style=\"\r\n      font-size:24px;\r\n      line-height:1.2;\r\n      font-weight:700;\r\n      color:#7f1d1d;\r\n  \">\r\n    {{organization.name}}\r\n  </div>\r\n\r\n\r\n  <!-- Contact information -->\r\n  <div style=\"\r\n      font-size:15px;\r\n      line-height:1.65;\r\n      color:#374151;\r\n  \">\r\n    {{organization.address}}<br>\r\n    {{organization.phone}}<br>\r\n    {{organization.email}}\r\n  </div>\r\n\r\n\r\n  <!-- Card notice -->\r\n  <div style=\"\r\n      font-size:13px;\r\n      line-height:1.55;\r\n      color:#4b5563;\r\n      border-top:1px solid #e5e7eb;\r\n      padding-top:13px;\r\n  \">\r\n    This card remains the property of\r\n    <strong>{{organization.name}}</strong>.\r\n    If found, please return it to the address above.\r\n  </div>\r\n\r\n\r\n  <!-- Authorized signature -->\r\n  <div style=\"\r\n      margin-top:5px;\r\n  \">\r\n\r\n    <div style=\"\r\n        width:45%;\r\n        border-top:1px solid #9ca3af;\r\n        padding-top:5px;\r\n        font-size:13px;\r\n        line-height:1.3;\r\n        color:#374151;\r\n    \">\r\n      {{authorized.signature}}\r\n    </div>\r\n\r\n    <div style=\"\r\n        font-size:12px;\r\n        line-height:1.3;\r\n        color:#6b7280;\r\n        margin-top:5px;\r\n    \">\r\n      {{authorized.name}} \u2014 Authorized Signatory\r\n    </div>\r\n\r\n  </div>\r\n\r\n</div>\r\n\r\n\r\n<!-- RIGHT QR SECTION -->\r\n<div style=\"\r\n    flex:0 0 185px;\r\n    width:185px;\r\n    height:100%;\r\n    display:flex;\r\n    flex-direction:column;\r\n    align-items:center;\r\n    justify-content:center;\r\n    gap:19px;\r\n\">\r\n\r\n\r\n  <!-- QR container -->\r\n  <div style=\"\r\n      width:165px;\r\n      height:165px;\r\n      background:#f9fafb;\r\n      border:1px solid #e5e7eb;\r\n      border-radius:10px;\r\n      padding:13px;\r\n      box-sizing:border-box;\r\n      display:flex;\r\n      align-items:center;\r\n      justify-content:center;\r\n  \">\r\n\r\n    <span style=\"\r\n        width:139px;\r\n        height:139px;\r\n        display:flex;\r\n        align-items:center;\r\n        justify-content:center;\r\n        line-height:0;\r\n        overflow:hidden;\r\n    \">\r\n      {{card.qr_code}}\r\n    </span>\r\n\r\n  </div>\r\n\r\n\r\n  <!-- Verification code -->\r\n  <span style=\"\r\n      display:block;\r\n      width:185px;\r\n      font-size:12px;\r\n      line-height:1.3;\r\n      color:#6b7280;\r\n      text-align:center;\r\n  \">\r\n    Scan to verify \u00b7 {{card.verification_code}}\r\n  </span>\r\n\r\n\r\n  <!-- Serial -->\r\n  <span style=\"\r\n      display:block;\r\n      width:185px;\r\n      font-size:11px;\r\n      line-height:1.3;\r\n      color:#9ca3af;\r\n      text-align:center;\r\n  \">\r\n    Serial: {{card.serial_number}}\r\n  </span>\r\n\r\n</div>\r\n\r\n  </div>\r\n\r\n  <!-- Bottom accent -->\r\n\r\n  <div style=\"\r\n      position:absolute;\r\n      bottom:0;\r\n      left:0;\r\n      width:100%;\r\n      height:15px;\r\n      background:#7f1d1d;\r\n  \"></div>\r\n\r\n</div>\r\n",
