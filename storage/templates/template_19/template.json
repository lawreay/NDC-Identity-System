    "front_html": "<div style=\"width:856px;height:540px;box-sizing:border-box;overflow:hidden;background:#ffffff;font-family:Arial,sans-serif;color:#1f2937;position:relative;\">\r\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:110px;background:#7f1d1d;\"></div>\r\n  <div style=\"position:absolute;top:110px;left:0;width:100%;height:8px;background:#f2c14e;\"></div>\r\n\r\n  <div style=\"position:relative;padding:20px 30px 0 30px;display:flex;align-items:center;gap:14px;height:90px;\">\r\n    <img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:56px;height:56px;object-fit:contain;background:#fff;border-radius:8px;padding:4px;\">\r\n    <div style=\"color:#fff;line-height:1.25;\">\r\n      <div style=\"font-size:22px;font-weight:700;letter-spacing:.5px;\">{{organization.name}}</div>\r\n      <div style=\"font-size:13px;color:#fcd9a0;text-transform:uppercase;letter-spacing:1.5px;\">Student Identification Card</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"position:relative;display:flex;padding:30px 40px 0 40px;gap:36px;\">\r\n    <div style=\"flex:0 0 160px;\">\r\n      <div style=\"width:160px;height:160px;border-radius:14px;border:5px solid #7f1d1d;background:#f3f4f6;overflow:hidden;\">\r\n        <img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\r\n      </div>\r\n    </div>\r\n    <div style=\"flex:1;display:flex;flex-direction:column;justify-content:center;gap:10px;\">\r\n      <div>\r\n        <div style=\"font-size:28px;font-weight:700;color:#111827;line-height:1.1;\">{{student.full_name}}</div>\r\n      </div>\r\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px 24px;font-size:13px;color:#374151;margin-top:8px;\">\r\n        <div><strong style=\"color:#7f1d1d;\">Student ID</strong><br>{{student.student_id}}</div>\r\n        <div><strong style=\"color:#7f1d1d;\">Blood Type</strong><br>{{student.blood_type}}</div>\r\n        <div><strong style=\"color:#7f1d1d;\">Valid Until</strong><br>{{student.expiry_date}}</div>\r\n        <div><strong style=\"color:#7f1d1d;\">Campus</strong><br>{{student.campus}}</div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"position:absolute;bottom:0;left:0;width:100%;height:14px;background:#7f1d1d;\"></div>\r\n</div>",
    "back_html": "<div style=\"width:856px;height:540px;box-sizing:border-box;overflow:hidden;background:#ffffff;font-family:Arial,sans-serif;color:#1f2937;position:relative;padding:36px 44px;\">\r\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:14px;background:#f2c14e;\"></div>\r\n\r\n  <div style=\"display:flex;gap:40px;height:100%;\">\r\n    <div style=\"flex:1;display:flex;flex-direction:column;justify-content:center;gap:16px;\">\r\n      <div style=\"font-size:19px;font-weight:700;color:#7f1d1d;\">{{organization.name}}</div>\r\n      <div style=\"font-size:13.5px;line-height:1.7;color:#374151;\">\r\n        {{organization.address}}<br>\r\n        {{organization.phone}}<br>\r\n        {{organization.email}}\r\n      </div>\r\n      <div style=\"font-size:12.5px;line-height:1.6;color:#4b5563;border-top:1px solid #e5e7eb;padding-top:14px;\">\r\n        This card remains the property of <strong>{{organization.name}}</strong>. If found, please return it to the address above.\r\n      </div>\r\n      <div style=\"margin-top:18px;\">\r\n        <div style=\"width:220px;border-top:1px solid #9ca3af;padding-top:6px;font-size:12px;color:#374151;\">\r\n          Signature: {{authorized.name}}\r\n        </div>\r\n        <div style=\"font-size:11px;color:#6b7280;margin-top:2px;\">Principal / Authorized Signatory</div>\r\n      </div>\r\n    </div>\r\n\r\n    <div style=\"flex:0 0 200px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;\">\r\n      <div style=\"background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;padding:16px;\">\r\n        <span style=\"width:140px;height:140px;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;\">{{card.qr_code}}</span>\r\n      </div>\r\n      <span style=\"font-size:11.5px;color:#6b7280;\">Scan to verify</span>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"position:absolute;bottom:0;left:0;width:100%;height:14px;background:#7f1d1d;\"></div>\r\n</div>",
