    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#ffffff;font-family:Arial,sans-serif;color:#1f2937;position:relative;\">\r\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:20%;background:#7f1d1d;\"></div>\r\n  <div style=\"position:absolute;top:20%;left:0;width:100%;height:1.5%;background:#f2c14e;\"></div>\r\n\r\n  <div style=\"position:relative;padding:3% 4% 0 4%;display:flex;align-items:center;gap:2%;height:16%;\">\r\n    <img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:10%;height:auto;aspect-ratio:1/1;object-fit:contain;background:#fff;border-radius:8px;padding:4px;\">\r\n    <div style=\"color:#fff;line-height:1.25;\">\r\n      <div style=\"font-size:1.7vw;font-weight:700;letter-spacing:.5px;\">{{organization.school_name}}</div>\r\n      <div style=\"font-size:0.95vw;color:#fcd9a0;text-transform:uppercase;letter-spacing:1.5px;\">{{organization.campus_name}} \u00b7 Student ID</div>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"position:relative;display:flex;padding:5% 5% 0 5%;gap:4%;\">\r\n    <div style=\"flex:0 0 20%;\">\r\n      <div style=\"width:100%;aspect-ratio:1/1;border-radius:14px;border:5px solid #7f1d1d;background:#f3f4f6;overflow:hidden;\">\r\n        <img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\r\n      </div>\r\n    </div>\r\n    <div style=\"flex:1;display:flex;flex-direction:column;justify-content:center;gap:1.5%;\">\r\n      <div>\r\n        <div style=\"font-size:2.3vw;font-weight:700;color:#111827;line-height:1.1;\">{{student.full_name}}</div>\r\n        <div style=\"font-size:1.1vw;color:#7f1d1d;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-top:4px;\">{{student.program}} \u00b7 {{student.class_level}}</div>\r\n      </div>\r\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:1.5% 3%;font-size:1vw;color:#374151;margin-top:2%;\">\r\n        <div><strong style=\"color:#7f1d1d;\">Student ID</strong><br>{{student.student_id}}</div>\r\n        <div><strong style=\"color:#7f1d1d;\">Department</strong><br>{{student.department}}</div>\r\n        <div><strong style=\"color:#7f1d1d;\">Issued</strong><br>{{student.issue_date}}</div>\r\n        <div><strong style=\"color:#7f1d1d;\">Valid Until</strong><br>{{student.expiry_date}}</div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"position:absolute;bottom:0;left:0;width:100%;height:2.5%;background:#7f1d1d;\"></div>\r\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#ffffff;font-family:Arial,sans-serif;color:#1f2937;position:relative;padding:4% 5%;\">\r\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:2.5%;background:#f2c14e;\"></div>\r\n\r\n  <div style=\"display:flex;gap:5%;height:100%;align-items:center;\">\r\n    <div style=\"flex:1;display:flex;flex-direction:column;justify-content:center;gap:3%;\">\r\n      <div style=\"font-size:1.6vw;font-weight:700;color:#7f1d1d;\">{{organization.name}}</div>\r\n      <div style=\"font-size:1vw;line-height:1.7;color:#374151;\">\r\n        {{organization.address}}<br>\r\n        {{organization.phone}}<br>\r\n        {{organization.email}}\r\n      </div>\r\n      <div style=\"font-size:0.9vw;line-height:1.6;color:#4b5563;border-top:1px solid #e5e7eb;padding-top:3%;\">\r\n        This card remains the property of <strong>{{organization.name}}</strong>. If found, please return it to the address above.\r\n      </div>\r\n      <div style=\"margin-top:3%;\">\r\n        <div style=\"width:45%;border-top:1px solid #9ca3af;padding-top:1%;font-size:0.9vw;color:#374151;\">\r\n          {{authorized.signature}}\r\n        </div>\r\n        <div style=\"font-size:0.85vw;color:#6b7280;margin-top:2px;\">{{authorized.name}} \u2014 Authorized Signatory</div>\r\n      </div>\r\n    </div>\r\n\r\n    <div style=\"flex:0 0 22%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6%;\">\r\n      <div style=\"background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;padding:8%;width:100%;box-sizing:border-box;display:flex;align-items:center;justify-content:center;\">\r\n        <span style=\"width:100%;aspect-ratio:1/1;display:inline-flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;\">{{card.qr_code}}</span>\r\n      </div>\r\n      <span style=\"font-size:0.8vw;color:#6b7280;text-align:center;\">Scan to verify \u00b7 {{card.verification_code}}</span>\r\n      <span style=\"font-size:0.75vw;color:#9ca3af;\">Serial: {{card.serial_number}}</span>\r\n    </div>\r\n  </div>\r\n\r\n  <div style=\"position:absolute;bottom:0;left:0;width:100%;height:2.5%;background:#7f1d1d;\"></div>\r\n</div>",
