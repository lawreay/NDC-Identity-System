    "front_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#ffffff;font-family:Arial,sans-serif;color:#1f2937;position:relative;\">\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:108px;background:#7f1d1d;\"></div>\n  <div style=\"position:absolute;top:108px;left:0;width:100%;height:8px;background:#f2c14e;\"></div>\n\n  <div style=\"position:relative;height:102px;padding:20px 34px 0 34px;display:flex;align-items:center;gap:20px;box-sizing:border-box;\">\n    <div style=\"width:72px;height:72px;flex:0 0 72px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#fff;border-radius:8px;padding:6px;box-sizing:border-box;\">\n      <img src=\"{{organization.logo}}\" alt=\"Logo\" style=\"width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain;display:block;\">\n    </div>\n    <div style=\"min-width:0;color:#fff;line-height:1.25;\">\n      <div style=\"max-width:690px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:24px;font-weight:700;letter-spacing:.5px;\">{{organization.school_name}}</div>\n      <div style=\"max-width:690px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;color:#fcd9a0;text-transform:uppercase;letter-spacing:1.5px;margin-top:3px;\">{{organization.campus_name}} &middot; Student ID</div>\n    </div>\n  </div>\n\n  <div style=\"position:relative;display:grid;grid-template-columns:170px minmax(0,1fr);gap:34px;align-items:center;padding:48px 42px 0 42px;box-sizing:border-box;\">\n    <div style=\"width:170px;height:170px;border-radius:14px;border:5px solid #7f1d1d;background:#f3f4f6;overflow:hidden;box-sizing:border-box;\">\n      <img src=\"{{student.photo}}\" alt=\"Student photo\" style=\"width:100%;height:100%;max-width:100%;max-height:100%;object-fit:cover;display:block;\">\n    </div>\n\n    <div style=\"min-width:0;display:grid;gap:16px;align-content:center;box-sizing:border-box;\">\n      <div style=\"min-width:0;\">\n        <div style=\"max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:32px;font-weight:700;color:#111827;line-height:1.1;\">{{student.full_name}}</div>\n        <div style=\"max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px;line-height:1.25;color:#7f1d1d;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-top:6px;\">{{student.program}} &middot; {{student.class_level}}</div>\n      </div>\n\n      <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px 24px;font-size:14px;line-height:1.25;color:#374151;\">\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#7f1d1d;\">Student ID</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.student_id}}</span></div>\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#7f1d1d;\">Department</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.department}}</span></div>\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#7f1d1d;\">Issued</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.issue_date}}</span></div>\n        <div style=\"min-width:0;overflow:hidden;\"><strong style=\"color:#7f1d1d;\">Valid Until</strong><br><span style=\"display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{student.expiry_date}}</span></div>\n      </div>\n    </div>\n  </div>\n\n  <div style=\"position:absolute;bottom:0;left:0;width:100%;height:14px;background:#7f1d1d;\"></div>\n</div>",
    "back_html": "<div style=\"width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#ffffff;font-family:Arial,sans-serif;color:#1f2937;position:relative;padding:24px 46px;\">\n  <div style=\"position:absolute;top:0;left:0;width:100%;height:15px;background:#f2c14e;\"></div>\n\n  <div style=\"display:grid;grid-template-columns:minmax(0,1fr) 185px;gap:44px;width:100%;height:100%;align-items:center;box-sizing:border-box;\">\n    <div style=\"min-width:0;height:100%;display:flex;flex-direction:column;justify-content:center;gap:18px;box-sizing:border-box;\">\n      <div style=\"max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:24px;line-height:1.2;font-weight:700;color:#7f1d1d;\">{{organization.name}}</div>\n      <div style=\"max-height:86px;overflow:hidden;font-size:15px;line-height:1.55;color:#374151;\">\n        {{organization.address}}<br>\n        {{organization.phone}}<br>\n        {{organization.email}}\n      </div>\n      <div style=\"font-size:13px;line-height:1.55;color:#4b5563;border-top:1px solid #e5e7eb;padding-top:13px;box-sizing:border-box;\">\n        This card remains the property of <strong>{{organization.name}}</strong>. If found, please return it to the address above.\n      </div>\n      <div style=\"margin-top:5px;\">\n        <div style=\"width:260px;border-top:1px solid #9ca3af;padding-top:5px;font-size:13px;line-height:1.3;color:#374151;box-sizing:border-box;\">{{authorized.signature}}</div>\n        <div style=\"max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;line-height:1.3;color:#6b7280;margin-top:5px;\">{{authorized.name}} - Authorized Signatory</div>\n      </div>\n    </div>\n\n    <div style=\"width:185px;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:19px;box-sizing:border-box;\">\n      <div style=\"width:165px;height:165px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;padding:13px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;\">\n        <span style=\"width:139px;height:139px;display:flex;align-items:center;justify-content:center;line-height:0;overflow:hidden;box-sizing:border-box;\">{{card.qr_code}}</span>\n      </div>\n      <span style=\"display:block;width:185px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;line-height:1.3;color:#6b7280;text-align:center;\">Scan to verify &middot; {{card.verification_code}}</span>\n      <span style=\"display:block;width:185px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;line-height:1.3;color:#9ca3af;text-align:center;\">Serial: {{card.serial_number}}</span>\n    </div>\n  </div>\n\n  <div style=\"position:absolute;bottom:0;left:0;width:100%;height:15px;background:#7f1d1d;\"></div>\n</div>",
